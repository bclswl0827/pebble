+# Host build of the emulated Mac's Anisette core, for checking it against a reference without a
+# device. See README.md.
+
+cmake_minimum_required(VERSION 3.22.1)
+project(macadi_host CXX C)
+
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+include(${CMAKE_CURRENT_SOURCE_DIR}/../../main/cpp/macadi/MacAdi.cmake)
+
+add_executable(macadi_cli macadi_cli.cpp)
+target_link_libraries(macadi_cli PRIVATE macadi_core)
+
+# scripts/adi-emulator-diff/compare-libmacadi.sh: this port against os-findmy-e's adi-core.
+add_executable(macadi_diff macadi_diff.cpp)
+target_link_libraries(macadi_diff PRIVATE macadi_core)
diff --git a/app/src/test/macadi-host/macadi_cli.cpp b/app/src/test/macadi-host/macadi_cli.cpp
new file mode 100644
index 0000000..4f861d8
--- /dev/null
+++ b/app/src/test/macadi-host/macadi_cli.cpp
@@ -0,0 +1,89 @@
+// One Anisette header set from the emulated Mac, on the host, printed as JSON.
+//
+//   macadi_cli <CoreADI x86_64 slice> <dispatch offset, hex> <store dir> <host uuid, 32 hex>
+//              <frozen unix time, or -1 for the real clock> [--load-only]
+//
+// The store directory is read and never written: this is for comparing output, and a check that
+// advanced the machine's state would make the next comparison against a different machine.
+//
+// --load-only stops after loading and one Initialize + IsMachineProvisioned, which needs no
+// provisioned store and so can run anywhere the library can be downloaded.
+
+#include <cstdio>
+#include <cstdlib>
+#include <dirent.h>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "core_adi.h"
+#include "error.h"
+
+namespace {
+
+std::vector<uint8_t> readFile(const std::string &path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw macadi::Error("cannot read " + path);
+    return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+}
+
+std::string hex(const std::vector<uint8_t> &b) {
+    static const char *digits = "0123456789abcdef";
+    std::string out;
+    for (const uint8_t c : b) {
+        out.push_back(digits[c >> 4]);
+        out.push_back(digits[c & 15]);
+    }
+    return out;
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    if (argc < 6) {
+        std::fprintf(stderr, "usage: %s coreadi dispatch_hex store_dir host_uuid_hex frozen [--load-only]\n",
+                     argv[0]);
+        return 2;
+    }
+    try {
+        const std::vector<uint8_t> image = readFile(argv[1]);
+        macadi::CoreAdi adi(image, std::strtoull(argv[2], nullptr, 16));
+
+        const std::string uuidHex = argv[4];
+        if (uuidHex.size() != 32) throw macadi::Error("host uuid must be 32 hex characters");
+        uint8_t uuid[16];
+        for (int i = 0; i < 16; i++) uuid[i] = static_cast<uint8_t>(std::stoul(uuidHex.substr(i * 2, 2), nullptr, 16));
+        adi.setHostUuid(uuid);
+        adi.setFrozenTime(std::stoll(argv[5]));
+
+        if (argc > 6 && std::string(argv[6]) == "--load-only") {
+            try {
+                adi.headers(-2);
+                std::printf("{\"loaded\": true, \"provisioned\": true}\n");
+            } catch (const macadi::NotProvisioned &) {
+                std::printf("{\"loaded\": true, \"provisioned\": false}\n");
+            }
+            return 0;
+        }
+
+        if (DIR *dir = opendir(argv[3])) {
+            while (const dirent *e = readdir(dir)) {
+                const std::string name = e->d_name;
+                if (name == "." || name == "..") continue;
+                adi.storePut(name, readFile(std::string(argv[3]) + "/" + name));
+            }
+            closedir(dir);
+        } else {
+            throw macadi::Error(std::string("cannot open store ") + argv[3]);
+        }
+
+        const macadi::Headers h = adi.headers(-2);
+        std::printf("{\"mid\": \"%s\", \"otp\": \"%s\", \"routing\": %llu}\n", hex(h.mid).c_str(),
+                    hex(h.otp).c_str(), static_cast<unsigned long long>(h.routing));
+        return 0;
+    } catch (const std::exception &e) {
+        std::fprintf(stderr, "error: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/app/src/test/macadi-host/macadi_diff.cpp b/app/src/test/macadi-host/macadi_diff.cpp
new file mode 100644
index 0000000..9277d43
--- /dev/null
+++ b/app/src/test/macadi-host/macadi_diff.cpp
@@ -0,0 +1,154 @@
+// scripts/adi-emulator-diff/adi-diff.rs, replayed against this repository's C++ port.
+//
+//   macadi_diff <CoreADI x86_64 slice> <dispatch offset, hex> [provisioned store dir]
+//
+// Makes the same calls as os-findmy-e's adi-core driver, with the same frozen clock, host UUID
+// and synthetic spims, and prints the same lines in the same format - including Rust's {:?} for
+// the replies - so `diff` between the two outputs is the whole comparison. Sends nothing anywhere.
+//
+// With a store directory (the files under files/anisette/mac/store/ of a provisioned install, or
+// any provisioned adi-core store) it then also runs one header session on that machine with the
+// clock still frozen: the OTP path, which an unprovisioned machine never reaches. adi-diff.rs
+// takes the same optional argument.
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <dirent.h>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "core_adi.h"
+#include "error.h"
+#include "sha256.h"
+
+namespace {
+
+std::vector<uint8_t> readFile(const std::string &path) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) throw macadi::Error("cannot read " + path);
+    return {std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>()};
+}
+
+std::string hex(const std::vector<uint8_t> &b, size_t limit = SIZE_MAX) {
+    static const char *digits = "0123456789abcdef";
+    std::string out;
+    for (size_t i = 0; i < b.size() && i < limit; i++) {
+        out.push_back(digits[b[i] >> 4]);
+        out.push_back(digits[b[i] & 15]);
+    }
+    return out;
+}
+
+// Rust's {:?} of adi_core::Reply.
+std::string reply(const macadi::CoreAdi::Reply &r) {
+    return "Reply { rc: " + std::to_string(r.rc) + ", ret: " + std::to_string(r.ret) + " }";
+}
+
+// adi-diff.rs's store_sha: every file in the VM, path then length (u64 LE) then bytes, in the
+// map's order (BTreeMap there, std::map here: both sort by bytes).
+std::string storeSha(macadi::CoreAdi &adi) {
+    hostcheck::Sha256 h;
+    for (const auto &f : adi.vmFiles()) {
+        h.update(reinterpret_cast<const uint8_t *>(f.first.data()), f.first.size());
+        uint8_t len[8];
+        uint64_t n = f.second.size();
+        for (int i = 0; i < 8; i++) len[i] = static_cast<uint8_t>(n >> (8 * i));
+        h.update(len, 8);
+        h.update(f.second.data(), f.second.size());
+    }
+    return hex(h.digest(), 8);
+}
+
+// A failure the Rust driver would print as Err(...). Never expected; any of these is a diff.
+template <typename F>
+void line(const std::string &label, F body) {
+    try {
+        std::printf("%s %s\n", label.c_str(), body().c_str());
+    } catch (const std::exception &e) {
+        std::printf("%s Err(%s)\n", label.c_str(), e.what());
+    }
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: %s coreadi dispatch_hex [store_dir]\n", argv[0]);
+        return 2;
+    }
+    try {
+        const std::vector<uint8_t> image = readFile(argv[1]);
+        macadi::CoreAdi adi(image, std::strtoull(argv[2], nullptr, 16));
+        const uint8_t uuid[16] = {0x10, 0x32, 0x54, 0x76, 0x98, 0xba, 0xdc, 0xfe,
+                                  0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef};
+        adi.setHostUuid(uuid);
+        adi.setFrozenTime(1790000000);
+
+        line("begin_session", [&] { return "Ok(" + reply(adi.rawBeginSession()) + ")"; });
+        line("is_machine_provisioned", [&] { return "Ok(" + reply(adi.isMachineProvisioned(-2)) + ")"; });
+        line("request_otp(unprovisioned)", [&] {
+            const auto o = adi.requestOtp(-2);
+            return "Ok((" + reply(o.reply) + ", \"" + hex(o.mid) + "\", \"" + hex(o.otp) + "\"))";
+        });
+        line("get_routing", [&] {
+            const auto r = adi.getRouting(-2);
+            return "Ok((" + reply(r.first) + ", " + std::to_string(r.second) + "))";
+        });
+        std::printf("store %s\n", storeSha(adi).c_str());
+
+        uint64_t seed = 0x9E3779B97F4A7C15ull;
+        const size_t lengths[] = {0, 16, 256, 1024, 4096};
+        for (size_t i = 0; i < 5; i++) {
+            const size_t len = lengths[i];
+            std::vector<uint8_t> spim;
+            for (size_t j = 0; j < len; j++) {
+                seed ^= seed << 13;
+                seed ^= seed >> 7;
+                seed ^= seed << 17;
+                spim.push_back(static_cast<uint8_t>(seed));
+            }
+            line("begin_session", [&] { return "Ok(" + reply(adi.rawBeginSession()) + ")"; });
+            const std::string label = "provisioning_start[" + std::to_string(i) + "] len=" +
+                                      std::to_string(len);
+            try {
+                const auto p = adi.provisioningStart(-2, spim);
+                std::printf("%s %s session=%u cpim(%zu)=%s\n", label.c_str(), reply(p.reply).c_str(),
+                            p.session, p.cpim.size(), hex(hostcheck::sha256(p.cpim), 16).c_str());
+            } catch (const std::exception &e) {
+                std::printf("%s error %s\n", label.c_str(), e.what());
+            }
+            std::printf("store %s\n", storeSha(adi).c_str());
+        }
+
+        if (argc > 3) {
+            // A provisioned machine, then one header session on it: the OTP path.
+            DIR *dir = opendir(argv[3]);
+            if (dir == nullptr) throw macadi::Error(std::string("cannot open store ") + argv[3]);
+            while (const dirent *e = readdir(dir)) {
+                const std::string name = e->d_name;
+                if (name == "." || name == "..") continue;
+                adi.storePut(name, readFile(std::string(argv[3]) + "/" + name));
+            }
+            closedir(dir);
+            line("provisioned begin_session", [&] { return "Ok(" + reply(adi.rawBeginSession()) + ")"; });
+            line("provisioned is_machine_provisioned",
+                 [&] { return "Ok(" + reply(adi.isMachineProvisioned(-2)) + ")"; });
+            line("provisioned request_otp", [&] {
+                const auto o = adi.requestOtp(-2);
+                return "Ok((" + reply(o.reply) + ", \"" + hex(o.mid) + "\", \"" + hex(o.otp) + "\"))";
+            });
+            line("provisioned get_routing", [&] {
+                const auto r = adi.getRouting(-2);
+                return "Ok((" + reply(r.first) + ", " + std::to_string(r.second) + "))";
+            });
+            std::printf("provisioned store %s\n", storeSha(adi).c_str());
+        }
+        return 0;
+    } catch (const std::exception &e) {
+        std::fprintf(stderr, "error: %s\n", e.what());
+        return 1;
+    }
+}
diff --git a/app/src/test/macadi-host/sha256.h b/app/src/test/macadi-host/sha256.h
new file mode 100644
index 0000000..37065e5
--- /dev/null
+++ b/app/src/test/macadi-host/sha256.h
@@ -0,0 +1,108 @@
+// SHA-256 for the host checks only, so macadi_diff needs nothing beyond the C++ standard library.
+// FIPS 180-4, straightforwardly; not constant-time and not for anything secret.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace hostcheck {
+
+class Sha256 {
+public:
+    Sha256() { reset(); }
+
+    void update(const uint8_t *data, size_t len) {
+        for (size_t i = 0; i < len; i++) {
+            block_[fill_++] = data[i];
+            if (fill_ == 64) {
+                compress();
+                fill_ = 0;
+            }
+        }
+        bits_ += static_cast<uint64_t>(len) * 8;
+    }
+
+    std::vector<uint8_t> digest() {
+        const uint64_t bits = bits_;
+        const uint8_t one = 0x80, zero = 0;
+        update(&one, 1);
+        while (fill_ != 56) update(&zero, 1);
+        uint8_t len[8];
+        for (int i = 0; i < 8; i++) len[i] = static_cast<uint8_t>(bits >> (56 - 8 * i));
+        update(len, 8);
+        std::vector<uint8_t> out(32);
+        for (int i = 0; i < 8; i++) {
+            for (int j = 0; j < 4; j++) out[i * 4 + j] = static_cast<uint8_t>(h_[i] >> (24 - 8 * j));
+        }
+        reset();
+        return out;
+    }
+
+private:
+    static uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+
+    void reset() {
+        static const uint32_t init[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+                                         0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+        std::memcpy(h_, init, sizeof(h_));
+        fill_ = 0;
+        bits_ = 0;
+    }
+
+    void compress() {
+        static const uint32_t k[64] = {
+            0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4,
+            0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe,
+            0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
+            0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+            0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
+            0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+            0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116,
+            0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+            0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+            0xc67178f2};
+        uint32_t w[64];
+        for (int i = 0; i < 16; i++) {
+            w[i] = (static_cast<uint32_t>(block_[i * 4]) << 24) |
+                   (static_cast<uint32_t>(block_[i * 4 + 1]) << 16) |
+                   (static_cast<uint32_t>(block_[i * 4 + 2]) << 8) | block_[i * 4 + 3];
+        }
+        for (int i = 16; i < 64; i++) {
+            const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+            const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+        uint32_t a = h_[0], b = h_[1], c = h_[2], d = h_[3], e = h_[4], f = h_[5], g = h_[6],
+                 h = h_[7];
+        for (int i = 0; i < 64; i++) {
+            const uint32_t t1 = h + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) +
+                                k[i] + w[i];
+            const uint32_t t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+            h = g;
+            g = f;
+            f = e;
+            e = d + t1;
+            d = c;
+            c = b;
+            b = a;
+            a = t1 + t2;
+        }
+        h_[0] += a; h_[1] += b; h_[2] += c; h_[3] += d;
+        h_[4] += e; h_[5] += f; h_[6] += g; h_[7] += h;
+    }
+
+    uint32_t h_[8];
+    uint8_t block_[64];
+    size_t fill_;
+    uint64_t bits_;
+};
+
+inline std::vector<uint8_t> sha256(const std::vector<uint8_t> &data) {
+    Sha256 h;
+    h.update(data.data(), data.size());
+    return h.digest();
+}
+
+}  // namespace hostcheck
diff --git a/app/src/test/python/test_emulated_mac.py b/app/src/test/python/test_emulated_mac.py
