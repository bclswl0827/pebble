@@ -0,0 +1,97 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import java.io.Closeable;
+import java.io.File;
+import java.io.IOException;
+import java.util.Map;
+
+/**
+ * The emulated Mac's CoreADI, as {@link EmulatedMacAnisette} uses it: whatever runs it.
+ *
+ * <p><b>Two implementations, and the app process only ever holds one of them.</b>
+ * {@link MacCoreAdi} is the JNI face of {@code libmacadi.so}, and it is loaded only in the
+ * {@code :macadi} process, by {@link MacAdiService}. The app talks to it through
+ * {@link RemoteMacAdi}, over binder. So a native crash in Unicorn or in Apple's code kills that
+ * process and not the app (AGENTS.md rule 4, #232), and the GPL-2.0 emulator never shares a
+ * process with the Apache-2.0 libraries or the map SDKs (docs/emulated-mac-emulator-choice.md).
+ *
+ * <p><b>An interface so the logic above it can be tested on the JVM</b> (rule 13): the state
+ * machine in {@link EmulatedMacAnisette} and the requests in {@link MacProvisioning} need neither
+ * the emulator nor a device to check.
+ *
+ * <p>The semantics are {@link MacCoreAdi}'s; see it for what each call does.
+ */
+interface MacAdi extends Closeable {
+
+    /** Apple's "no account" pseudo-DSID, which machine-level Anisette is always asked for. */
+    long ANONYMOUS_DS_ID = -2L;
+
+    /** The library's own answer that this machine has never been provisioned. */
+    final class NotProvisionedException extends IllegalStateException {
+        public NotProvisionedException(String message) {
+            super(message);
+        }
+    }
+
+    /**
+     * The process running the emulator died during a call. Not something to retry in this
+     * process, and recorded so the next launch does not walk into it again.
+     */
+    final class EmulatorDiedException extends IllegalStateException {
+        public EmulatorDiedException(String message, Throwable cause) {
+            super(message, cause);
+        }
+    }
+
+    /** One Anisette header set. */
+    final class Headers {
+        /** {@code X-Apple-I-MD-M}, raw. */
+        public final byte[] machineId;
+        /** {@code X-Apple-I-MD}, raw. */
+        public final byte[] oneTimePassword;
+        /** {@code X-Apple-I-MD-RINFO}. */
+        public final long routing;
+
+        public Headers(byte[] machineId, byte[] oneTimePassword, long routing) {
+            this.machineId = machineId;
+            this.oneTimePassword = oneTimePassword;
+            this.routing = routing;
+        }
+    }
+
+    /** Starts an emulator over a library already checked against {@link MacCoreAdi#BUILD_SHA256}. */
+    interface Opener {
+        MacAdi open(File library) throws IOException;
+    }
+
+    void setHostUuid(byte[] uuid);
+
+    void storePut(String name, byte[] contents);
+
+    /** The library's provisioning state, by file name. Persist it after every call. */
+    Map<String, byte[]> storeFiles();
+
+    /** @throws NotProvisionedException if this machine has never been provisioned */
+    Headers headers(long dsId);
+
+    /**
+     * Turn Apple's {@code spim} into the {@code cpim} to send back.
+     *
+     * @param sessionOut receives the session id {@link #provisioningFinish} needs
+     */
+    byte[] provisioningBegin(long dsId, byte[] spim, int[] sessionOut);
+
+    void provisioningFinish(long dsId, int session, byte[] persistentTokenMetadata,
+                            byte[] trustKey, long routing);
+
+    /**
+     * Whether whatever runs the emulator has gone away between calls, so this one is useless and
+     * a new one should be opened. Not a fault: see {@link RemoteMacAdi}.
+     */
+    default boolean isGone() {
+        return false;
+    }
+
+    @Override
+    void close();
+}
diff --git a/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacAdiService.java b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacAdiService.java
new file mode 100644
index 0000000..a482b4a
--- /dev/null
+++ b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacAdiService.java
@@ -0,0 +1,211 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.Binder;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.os.Process;
+import android.system.ErrnoException;
+import android.system.Os;
+import android.system.OsConstants;
+import android.util.Log;
+
+import java.io.File;
+import java.util.Map;
+
+/**
+ * The emulated Mac, in a process of its own: {@code libmacadi.so} is loaded here and nowhere else.
+ *
+ * <p>Declared with {@code android:process=":macadi"}. Two reasons, either sufficient:
+ *
+ * <ul>
+ *   <li><b>A native crash here is not the app's.</b> Unicorn and Apple's emulated code can fault
+ *       in ways no {@code catch} sees - #232 made the app unopenable that way (AGENTS.md rule 4).
+ *       If this process dies, the call in flight fails with {@link android.os.DeadObjectException}
+ *       in the app, {@link EmulatedMacAnisette} records it and falls back to a remote server, and
+ *       the sign-in screen stays up.</li>
+ *   <li><b>The GPL code is a separate program.</b> Unicorn is GPL-2.0; this process links it, and
+ *       the app process, with the Apache-2.0 libraries and the map SDKs, never does. They talk
+ *       over binder. See docs/emulated-mac-emulator-choice.md and {@code NOTICE.md}.</li>
+ * </ul>
+ *
+ * <p>The protocol is a handful of transaction codes on a plain {@link Binder}, so it needs no AIDL
+ * build step. {@link RemoteMacAdi} is the other end. One emulator per process; the app holds one
+ * connection at a time ({@link EmulatedMacAnisette}'s state is static), so a second {@link #OPEN}
+ * replaces the first.
+ *
+ * <p>The library is passed as a path, not as bytes: it is 3.4 MB and a binder transaction is
+ * capped at about 1 MB. It is checked against {@link MacCoreAdi#BUILD_SHA256} again here, because
+ * the dispatcher offset is only meaningful for those exact bytes.
+ */
+public final class MacAdiService extends Service {
+    private static final String TAG = "MacAdiService";
+
+    /** The process name after the package, as declared in the manifest. */
+    public static final String PROCESS_SUFFIX = ":macadi";
+
+    static final String DESCRIPTOR = "dev.wander.android.opentagviewer.anisette.MacAdi";
+
+    static final int OPEN = IBinder.FIRST_CALL_TRANSACTION;
+    static final int SET_HOST_UUID = OPEN + 1;
+    static final int STORE_PUT = OPEN + 2;
+    static final int STORE_FILES = OPEN + 3;
+    static final int HEADERS = OPEN + 4;
+    static final int PROVISIONING_BEGIN = OPEN + 5;
+    static final int PROVISIONING_FINISH = OPEN + 6;
+    static final int CLOSE = OPEN + 7;
+
+    /**
+     * <b>Tests only.</b> Die by a signal, mid-call, as a fault in the emulator would. Here and not
+     * in a fake because the thing under test is the real process boundary. Nothing outside the app
+     * can send it: the service is not exported.
+     */
+    static final int DIE_FOR_A_TEST = OPEN + 99;
+
+    static final int OK = 0;
+    static final int NOT_PROVISIONED = 1;
+    static final int FAILED = 2;
+
+    private final Object lock = new Object();
+    private MacCoreAdi adi;
+
+    @Override
+    public IBinder onBind(final Intent intent) {
+        return new Binder() {
+            @Override
+            protected boolean onTransact(final int code, final Parcel data, final Parcel reply,
+                                         final int flags) {
+                if (code == INTERFACE_TRANSACTION) {
+                    reply.writeString(DESCRIPTOR);
+                    return true;
+                }
+                if (code < OPEN || code > DIE_FOR_A_TEST) {
+                    return false;
+                }
+                data.enforceInterface(DESCRIPTOR);
+                synchronized (MacAdiService.this.lock) {
+                    try {
+                        handle(code, data, reply);
+                    } catch (final MacAdi.NotProvisionedException e) {
+                        reply.setDataPosition(0);
+                        reply.setDataSize(0);
+                        reply.writeInt(NOT_PROVISIONED);
+                        reply.writeString(String.valueOf(e.getMessage()));
+                    } catch (final Exception | LinkageError e) {
+                        Log.w(TAG, "the emulated Mac refused a call", e);
+                        reply.setDataPosition(0);
+                        reply.setDataSize(0);
+                        reply.writeInt(FAILED);
+                        reply.writeString(e.getMessage() == null ? e.toString() : e.getMessage());
+                    }
+                }
+                return true;
+            }
+        };
+    }
+
+    private void handle(final int code, final Parcel data, final Parcel reply) throws Exception {
+        switch (code) {
+            case OPEN: {
+                final byte[] image = MacCoreAdiFetcher.readFile(new File(data.readString()));
+                final String sha = MacCoreAdiFetcher.sha256(image);
+                if (!MacCoreAdi.BUILD_SHA256.equals(sha)) {
+                    throw new IllegalStateException("not the pinned CoreADI build: " + sha);
+                }
+                if (this.adi != null) {
+                    this.adi.close();
+                    this.adi = null;
+                }
+                this.adi = new MacCoreAdi(image);
+                reply.writeInt(OK);
+                return;
+            }
+            case SET_HOST_UUID:
+                open().setHostUuid(data.createByteArray());
+                reply.writeInt(OK);
+                return;
+            case STORE_PUT:
+                open().storePut(data.readString(), data.createByteArray());
+                reply.writeInt(OK);
+                return;
+            case STORE_FILES: {
+                final Map<String, byte[]> files = open().storeFiles();
+                reply.writeInt(OK);
+                reply.writeInt(files.size());
+                for (final Map.Entry<String, byte[]> file : files.entrySet()) {
+                    reply.writeString(file.getKey());
+                    reply.writeByteArray(file.getValue());
+                }
+                return;
+            }
+            case HEADERS: {
+                final MacAdi.Headers headers = open().headers(data.readLong());
+                reply.writeInt(OK);
+                reply.writeByteArray(headers.machineId);
+                reply.writeByteArray(headers.oneTimePassword);
+                reply.writeLong(headers.routing);
+                return;
+            }
+            case PROVISIONING_BEGIN: {
+                final long dsId = data.readLong();
+                final byte[] spim = data.createByteArray();
+                final int[] session = new int[1];
+                final byte[] cpim = open().provisioningBegin(dsId, spim, session);
+                reply.writeInt(OK);
+                reply.writeByteArray(cpim);
+                reply.writeInt(session[0]);
+                return;
+            }
+            case PROVISIONING_FINISH:
+                open().provisioningFinish(data.readLong(), data.readInt(), data.createByteArray(),
+                        data.createByteArray(), data.readLong());
+                reply.writeInt(OK);
+                return;
+            case CLOSE:
+                if (this.adi != null) {
+                    this.adi.close();
+                    this.adi = null;
+                }
+                reply.writeInt(OK);
+                return;
+            case DIE_FOR_A_TEST:
+                dieLikeACrash();
+                return;
+            default:
+                throw new IllegalStateException("unknown call " + code);
+        }
+    }
+
+    private MacCoreAdi open() {
+        if (this.adi == null) {
+            throw new IllegalStateException("the emulated Mac has not been opened");
+        }
+        return this.adi;
+    }
+
+    /** SIGSEGV, as a fault in Unicorn or Apple's code would be, and never returns. */
+    private static void dieLikeACrash() {
+        try {
+            Os.kill(Os.getpid(), OsConstants.SIGSEGV);
+        } catch (final ErrnoException e) {
+            Process.killProcess(Process.myPid());
+        }
+        // The signal can land on another thread; this one must not get as far as replying.
+        while (true) {
+            try {
+                Thread.sleep(10_000);
+            } catch (final InterruptedException ignored) {
+                // Keep waiting to die.
+            }
+            Process.killProcess(Process.myPid());
+        }
+    }
+
+    @Override
+    public void onDestroy() {
+        super.onDestroy();
+        // Nobody is bound, and the emulator is megabytes the system would keep cached for nothing.
+        Process.killProcess(Process.myPid());
+    }
+}
diff --git a/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdi.java b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdi.java
new file mode 100644
index 0000000..d7a371b
--- /dev/null
+++ b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdi.java
@@ -0,0 +1,139 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import java.nio.charset.StandardCharsets;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Apple's macOS CoreADI, running under an x86_64 emulator in {@code libmacadi.so}.
+ *
+ * <p><b>Why a Mac, on an Android phone.</b> Since 2026-10-12 Apple issues the Find My token
+ * ({@code searchPartyToken}) only to a sign-in whose Anisette machine was minted by a Mac or an
+ * iPhone, and since about 2026-10-20 its edge refuses any client that says it is Android. The
+ * Android libraries {@link LocalAnisette} loads mint Android machines, so they can no longer
+ * reach Find My at all. This runs the Mac library instead - the one in iTunes 12.8.3 for Mac -
+ * which mints Mac machines. See sacca97/os-findmy-e, which this is ported from, for the evidence.
+ *
+ * <p><b>One call is one emulated session.</b> The native side puts the emulator back to its
+ * post-load state before each of {@link #headers} and {@link #provisioningBegin}, so nothing
+ * builds up however long the app runs. Provisioning is the exception:
+ * {@link #provisioningBegin} and {@link #provisioningFinish} share one session and nothing may run
+ * between them.
+ *
+ * <p><b>Only ever loaded in the {@code :macadi} process</b>, by {@link MacAdiService}. Touching this
+ * class loads {@code libmacadi.so}, which is Unicorn (GPL-2.0) and Apple's code under emulation, and
+ * neither may share a process with the app: a native crash there would take the app with it
+ * (AGENTS.md rule 4), and the GPL code would share a program with the Apache-2.0 libraries and the
+ * map SDKs. The app reaches it through {@link RemoteMacAdi}.
+ *
+ * <p><b>Not thread-safe.</b> Callers hold their own lock; {@link MacAdiService} does.
+ */
+final class MacCoreAdi implements MacAdi {
+
+    /** The one build this knows how to drive: iTunes 12.8.3, CoreADI 4.19, x86_64 slice. */
+    public static final String BUILD_SHA256 =
+            "2eafc3c79c7f41a8afbfbeaaf23ee5dab5ad5bda55ec8e54dbc0ddf1d20ce630";
+
+    /**
+     * Where {@code _vdfut768ig}, the library's single dispatcher, sits in that build.
+     *
+     * <p>Tied to {@link #BUILD_SHA256}: the dispatcher's offset is a property of those exact bytes,
+     * and a different build at this offset would run arbitrary code as if it were the dispatcher.
+     */
+    static final long DISPATCH_OFFSET = 0x979A0L;
+
+    static {
+        System.loadLibrary("macadi");
+    }
+
+    private long handle;
+
+    /**
+     * Load the library's bytes into a fresh emulator.
+     *
+     * <p>The caller has already checked them against {@link #BUILD_SHA256};
+     * {@link MacCoreAdiFetcher} will not hand over anything else.
+     */
+    public MacCoreAdi(byte[] image) {
+        this.handle = nativeOpen(image, DISPATCH_OFFSET);
+    }
+
+    /** What the library hashes into the machine id. Fixed per machine; see {@link MacIdentity}. */
+    @Override
+    public void setHostUuid(byte[] uuid) {
+        nativeSetHostUuid(live(), uuid);
+    }
+
+    /** Tests only. A frozen clock makes the OTP a constant, which Apple refuses within a minute. */
+    void setFrozenTime(long unixSeconds) {
+        nativeSetFrozenTime(live(), unixSeconds);
+    }
+
+    @Override
+    public void storePut(String name, byte[] contents) {
+        nativeStorePut(live(), name, contents);
+    }
+
+    @Override
+    public Map<String, byte[]> storeFiles() {
+        final Object[] flat = nativeStoreFiles(live());
+        final Map<String, byte[]> out = new LinkedHashMap<>();
+        for (int i = 0; i + 1 < flat.length; i += 2) {
+            out.put(new String((byte[]) flat[i], StandardCharsets.UTF_8), (byte[]) flat[i + 1]);
+        }
+        return out;
+    }
+
+    @Override
+    public Headers headers(long dsId) {
+        final long[] routing = new long[1];
+        final byte[][] both = nativeHeaders(live(), dsId, routing);
+        return new Headers(both[0], both[1], routing[0]);
+    }
+
+    @Override
+    public byte[] provisioningBegin(long dsId, byte[] spim, int[] sessionOut) {
+        return nativeProvisioningBegin(live(), dsId, spim, sessionOut);
+    }
+
+    @Override
+    public void provisioningFinish(long dsId, int session, byte[] persistentTokenMetadata,
+                                   byte[] trustKey, long routing) {
+        nativeProvisioningFinish(live(), dsId, session, persistentTokenMetadata, trustKey, routing);
+    }
+
+    @Override
+    public void close() {
+        if (this.handle != 0) {
+            nativeClose(this.handle);
+            this.handle = 0;
+        }
+    }
+
+    private long live() {
+        if (this.handle == 0) {
+            throw new IllegalStateException("the emulated Mac has been closed");
+        }
+        return this.handle;
+    }
+
+    private static native long nativeOpen(byte[] image, long dispatch);
+
+    private static native void nativeClose(long handle);
+
+    private static native void nativeSetHostUuid(long handle, byte[] uuid);
+
+    private static native void nativeSetFrozenTime(long handle, long secs);
+
+    private static native void nativeStorePut(long handle, String name, byte[] data);
+
+    private static native Object[] nativeStoreFiles(long handle);
+
+    private static native byte[][] nativeHeaders(long handle, long dsId, long[] routingOut);
+
+    private static native byte[] nativeProvisioningBegin(
+            long handle, long dsId, byte[] spim, int[] sessionOut);
+
+    private static native void nativeProvisioningFinish(
+            long handle, long dsId, int session, byte[] ptm, byte[] tk, long routing);
+}
diff --git a/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdiFetcher.java b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdiFetcher.java
new file mode 100644
index 0000000..8489328
--- /dev/null
+++ b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacCoreAdiFetcher.java
@@ -0,0 +1,301 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import android.util.Log;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.zip.GZIPInputStream;
+
+/**
+ * Apple's macOS CoreADI, fetched from Apple: 3.5 MB of a 291 MB installer, in one request.
+ *
+ * <p><b>Where it is.</b> The library ships in iTunes 12.8.3 for Mac, which Apple still serves
+ * (KB DL1977). It sits several layers down - the disk image's HFS partition, then
+ * {@code Install iTunes.pkg}, then {@code CoreADI.pkg/Payload}, a gzipped cpio archive. But
+ * the image is a fixed file, and in it the payload happens to be stored uncompressed and in one
+ * piece, so its position is a constant: bytes {@link #PAYLOAD_OFFSET} to
+ * {@code PAYLOAD_OFFSET + PAYLOAD_LENGTH}. {@code scripts/locate_mac_coreadi.py} derives those
+ * numbers from the image and checks them, and can be rerun by anybody who doubts them.
+ *
+ * <p><b>Nothing is trusted that is not pinned.</b> The payload is checked against
+ * {@link #PAYLOAD_SHA256} before it is unpacked, and the library against
+ * {@link MacCoreAdi#BUILD_SHA256} before it is written - so a server that answered with
+ * something else, or ignored the range, produces an error rather than a library.
+ *
+ * <p>Apple's code is never redistributed by this project: it is fetched, at runtime, from Apple.
+ */
+public final class MacCoreAdiFetcher {
+    private static final String TAG = "MacCoreAdiFetcher";
+
+    public static final String DMG_URL = "https://secure-appldnld.apple.com/itunes12/"
+            + "041-56365-20210413-79A5AC6D-6B0A-46EC-B399-5A381183E3BE/iTunes12.8.3.dmg";
+
+    static final long PAYLOAD_OFFSET = 184_678_769L;
+    static final int PAYLOAD_LENGTH = 3_471_595;
+    static final String PAYLOAD_SHA256 =
+            "8a6c068c95036326eb2d2885fa60912ed0f7229d0939ae92934a70a3bb6cf025";
+
+    /** The library inside the payload. Apple's cpio names carry a leading {@code ./}. */
+    static final String FRAMEWORK_PATH =
+            "System/Library/PrivateFrameworks/CoreADI.framework/Versions/A/CoreADI";
+
+    private static final int CPU_TYPE_X86_64 = 0x01000007;
+
+    private MacCoreAdiFetcher() {
+    }
+
+    /** Thrown when what came back is not the library this app knows how to run. */
+    public static final class FetchException extends Exception {
+        public FetchException(String message) {
+            super(message);
+        }
+
+        public FetchException(String message, Throwable cause) {
+            super(message, cause);
+        }
+    }
+
+    /**
+     * Make sure {@code target} holds the library, fetching it if not.
+     *
+     * @return the library's bytes
+     */
+    public static byte[] ensure(File target) throws FetchException {
+        return ensure(target, DMG_URL);
+    }
+
+    /** As {@link #ensure(File)}, from {@code url}. Tests serve a fixture here. */
+    static byte[] ensure(File target, String url) throws FetchException {
+        if (target.isFile()) {
+            try {
+                final byte[] existing = readFile(target);
+                if (MacCoreAdi.BUILD_SHA256.equals(sha256(existing))) {
+                    return existing;
+                }
+                Log.w(TAG, "the stored library is not the expected build; fetching it again");
+            } catch (final IOException e) {
+                Log.w(TAG, "could not read the stored library; fetching it again", e);
+            }
+        }
+
+        final byte[] payload = fetchPayload(url);
+        final byte[] library = extract(payload);
+        write(target, library);
+        Log.i(TAG, String.format("fetched Apple's macOS CoreADI (%.1f MB downloaded)",
+                payload.length / 1e6));
+        return library;
+    }
+
+    private static byte[] fetchPayload(String url) throws FetchException {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setConnectTimeout(30_000);
+            connection.setReadTimeout(60_000);
+            connection.setRequestProperty("Range", "bytes=" + PAYLOAD_OFFSET + "-"
+                    + (PAYLOAD_OFFSET + PAYLOAD_LENGTH - 1));
+
+            // Anything but a partial response means the range was not honoured, and reading on
+            // would download the whole 291 MB image to throw nearly all of it away.
+            final int status = connection.getResponseCode();
+            if (status != HttpURLConnection.HTTP_PARTIAL) {
+                throw new FetchException("Apple answered HTTP " + status
+                        + " to a range request for the library; expected 206");
+            }
+
+            final byte[] payload = readAtMost(connection.getInputStream(), PAYLOAD_LENGTH + 1);
+            if (payload.length != PAYLOAD_LENGTH) {
+                throw new FetchException("expected " + PAYLOAD_LENGTH + " bytes of the installer,"
+                        + " got " + payload.length);
+            }
+            return payload;
+        } catch (final IOException e) {
+            throw new FetchException("could not download the library from Apple: "
+                    + e.getClass().getSimpleName() + ": " + e.getMessage(), e);
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    /**
+     * The x86_64 library out of the installer's payload. No network; pure bytes in, bytes out.
+     *
+     * @throws FetchException if either the payload or the library is not the pinned one
+     */
+    static byte[] extract(byte[] payload) throws FetchException {
+        final String payloadHash = sha256(payload);
+        if (!PAYLOAD_SHA256.equals(payloadHash)) {
+            throw new FetchException("the installer bytes are not the expected ones (sha256 "
+                    + payloadHash + ")");
+        }
+
+        final byte[] cpio;
+        try (GZIPInputStream in = new GZIPInputStream(new ByteArrayInputStream(payload))) {
+            cpio = readAtMost(in, 64 << 20);
+        } catch (final IOException e) {
+            throw new FetchException("could not decompress the installer payload", e);
+        }
+
+        final byte[] framework = fileFromCpio(cpio, FRAMEWORK_PATH);
+        final byte[] library = slice(framework, CPU_TYPE_X86_64);
+
+        final String libraryHash = sha256(library);
+        if (!MacCoreAdi.BUILD_SHA256.equals(libraryHash)) {
+            throw new FetchException("the library is not the expected build (sha256 "
+                    + libraryHash + ")");
+        }
+        return library;
+    }
+
+    /**
+     * One file's contents from an "odc" (old ASCII) cpio archive, which is what Apple's package
+     * payloads are.
+     *
+     * <p>Each entry: the magic {@code 070707}, then dev, ino, mode, uid, gid, nlink, rdev as six
+     * octal digits each, mtime as eleven, namesize as six and filesize as eleven - 76 bytes - then
+     * the name with its NUL, then the data. No padding.
+     */
+    static byte[] fileFromCpio(byte[] cpio, String wanted) throws FetchException {
+        int pos = 0;
+        while (pos + 76 <= cpio.length) {
+            final String magic = new String(cpio, pos, 6, StandardCharsets.US_ASCII);
+            if (!"070707".equals(magic)) {
+                throw new FetchException("not an odc cpio archive at offset " + pos);
+            }
+            final int nameSize = (int) octal(cpio, pos + 59, 6);
+            final long fileSize = octal(cpio, pos + 65, 11);
+            final int nameStart = pos + 76;
+            if (nameSize < 1 || nameStart + nameSize > cpio.length) {
+                throw new FetchException("truncated cpio entry at offset " + pos);
+            }
+            String name = new String(cpio, nameStart, nameSize - 1, StandardCharsets.UTF_8);
+            final int dataStart = nameStart + nameSize;
+            if (fileSize < 0 || dataStart + fileSize > cpio.length) {
+                throw new FetchException("truncated cpio data for " + name);
+            }
+            if ("TRAILER!!!".equals(name)) {
+                break;
+            }
+            if (name.startsWith("./")) {
+                name = name.substring(2);
+            }
+            // A hard link's twins carry no data; the entry that matters is the one that does.
+            if (wanted.equals(name) && fileSize > 0) {
+                final byte[] out = new byte[(int) fileSize];
+                System.arraycopy(cpio, dataStart, out, 0, out.length);
+                return out;
+            }
+            pos = dataStart + (int) fileSize;
+        }
+        throw new FetchException(wanted + " is not in the installer payload");
+    }
+
+    /** The slice for {@code cpuType} out of a Mach-O universal binary. */
+    static byte[] slice(byte[] fat, int cpuType) throws FetchException {
+        if (fat.length < 8 || be32(fat, 0) != 0xCAFEBABE) {
+            throw new FetchException("the library is not a universal binary");
+        }
+        final int count = be32(fat, 4);
+        for (int i = 0; i < count; i++) {
+            final int entry = 8 + 20 * i;
+            if (entry + 20 > fat.length) {
+                break;
+            }
+            if (be32(fat, entry) == cpuType) {
+                final int offset = be32(fat, entry + 8);
+                final int size = be32(fat, entry + 12);
+                if (offset < 0 || size < 0 || (long) offset + size > fat.length) {
+                    throw new FetchException("the library's slice lies outside the file");
+                }
+                final byte[] out = new byte[size];
+                System.arraycopy(fat, offset, out, 0, size);
+                return out;
+            }
+        }
+        throw new FetchException("the library has no x86_64 slice");
+    }
+
+    private static void write(File target, byte[] library) throws FetchException {
+        final File dir = target.getParentFile();
+        if (dir != null && !dir.isDirectory() && !dir.mkdirs()) {
+            throw new FetchException("could not create " + dir);
+        }
+        // Written beside and renamed over, so a process killed mid-write never leaves a
+        // truncated library that the hash check would then reject on every launch until cleared.
+        final File partial = new File(target.getPath() + ".partial");
+        try (FileOutputStream out = new FileOutputStream(partial)) {
+            out.write(library);
+            out.getFD().sync();
+        } catch (final IOException e) {
+            throw new FetchException("could not store the library", e);
+        }
+        if (!partial.renameTo(target)) {
+            throw new FetchException("could not store the library at " + target);
+        }
+    }
+
+    /**
+     * A whole file. Not {@code java.nio.file.Files}, which is API 26 and which core library
+     * desugaring does not cover - minSdk is 24.
+     */
+    static byte[] readFile(File file) throws IOException {
+        try (InputStream in = new FileInputStream(file)) {
+            return readAtMost(in, Integer.MAX_VALUE - 1);
+        }
+    }
+
+    private static long octal(byte[] b, int offset, int length) throws FetchException {
+        long v = 0;
+        for (int i = 0; i < length; i++) {
+            final int c = b[offset + i];
+            if (c < '0' || c > '7') {
+                throw new FetchException("bad octal field in the cpio archive");
+            }
+            v = v * 8 + (c - '0');
+        }
+        return v;
+    }
+
+    private static int be32(byte[] b, int offset) {
+        return ((b[offset] & 0xFF) << 24) | ((b[offset + 1] & 0xFF) << 16)
+                | ((b[offset + 2] & 0xFF) << 8) | (b[offset + 3] & 0xFF);
+    }
+
+    private static byte[] readAtMost(InputStream in, int limit) throws IOException {
+        final ByteArrayOutputStream out = new ByteArrayOutputStream();
+        final byte[] buffer = new byte[64 * 1024];
+        int read;
+        while ((read = in.read(buffer)) != -1) {
+            out.write(buffer, 0, read);
+            if (out.size() > limit) {
+                throw new IOException("more data than expected");
+            }
+        }
+        return out.toByteArray();
+    }
+
+    static String sha256(byte[] data) {
+        try {
+            final byte[] digest = MessageDigest.getInstance("SHA-256").digest(data);
+            final StringBuilder hex = new StringBuilder(digest.length * 2);
+            for (final byte b : digest) {
+                hex.append(String.format("%02x", b));
+            }
+            return hex.toString();
+        } catch (final NoSuchAlgorithmException e) {
+            throw new IllegalStateException("SHA-256 is always available", e);
+        }
+    }
+}
diff --git a/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacIdentity.java b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacIdentity.java
new file mode 100644
index 0000000..a46e475
--- /dev/null
+++ b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacIdentity.java
@@ -0,0 +1,213 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.Locale;
+
+/**
+ * Who the emulated Mac says it is - every value Apple sees about the machine, in one place.
+ *
+ * <p><b>Rule 11 applies with extra force.</b> The library hashes {@link #hostUuid()} into the
+ * machine id it mints, and Apple binds the provisioning to the device id, local user id and serial
+ * presented with it. So these are generated once, stored beside the library's own state
+ * ({@code identity.json} next to {@code store/}), and never regenerated: a second set is a second
+ * Mac on the user's Apple account, and the session established with the first stops working.
+ *
+ * <p><b>The shapes are a real Mac's, and the values are the ones that have been seen to
+ * work.</b> They follow sacca97/os-findmy-e's {@code mac_anisette.py} and {@code gsa.py}, which
+ * is the configuration Apple has been observed to issue a Find My token to. Where that source is
+ * inconsistent with itself - provisioning sends Darwin 22.3.0 and the login 22.2.0 - it is copied
+ * rather than corrected, because the consistent version is the untested one.
+ *
+ * <p><b>The model and the OS do not describe a real Mac either, and that is kept on purpose.</b>
+ * {@code MacBookPro13,2} is the 2016 13-inch MacBook Pro, whose last supported release is macOS 12
+ * Monterey, so it never ran macOS 13.1 (22C65). AGENTS.md rule 11 asks for a model, OS, build,
+ * CFNetwork and Darwin that describe one real release, and this is the exception: these are the
+ * exact values os-findmy-e was observed to receive {@code searchPartyToken} with, and a corrected
+ * pair is a configuration nobody has seen Apple accept. Changing either later is a new machine to
+ * Apple (a second device-list entry), so it waits for evidence that a consistent pair works.
+ *
+ * <p>The serial is this app's own {@code 0PENTAGV} serial, so the device-list entry stays
+ * recognisable (rule 11). Apple has not been seen to check serials at all.
+ */
+public final class MacIdentity {
+
+    static final String MODEL = "MacBookPro13,2";
+    static final String OS_NAME = "macOS";
+    static final String OS_VERSION = "13.1";
+    static final String OS_BUILD = "22C65";
+    static final String CFNETWORK = "1404.0.5";
+
+    /** What the sign-in reports, through FindMy.py's {@code DeviceIdentity}. */
+    static final String LOGIN_DARWIN = "22.2.0";
+
+    /** {@code X-MMe-Client-Info} for provisioning. FindMy.py composes the same string at login. */
+    static final String CLIENT_INFO = "<" + MODEL + "> <" + OS_NAME + ";" + OS_VERSION + ";"
+            + OS_BUILD + "> <com.apple.AuthKit/1 (com.apple.akd/1.0)>";
+
+    /** The provisioning requests' User-Agent - Darwin 22.3.0 here, as in the reference. */
+    static final String PROVISIONING_USER_AGENT = "akd/1.0 CFNetwork/" + CFNETWORK
+            + " Darwin/22.3.0";
+
+    /**
+     * A Mac's {@code X-Mme-Device-Id} is its provisioning UDID - eight hex, a dash, sixteen hex -
+     * and not its hardware UUID.
+     */
+    private static final String UDID_PREFIX = "00006000";
+
+    private static final String FILE = "identity.json";
+
+    private final String deviceId;
+    private final String localUserUuid;
+    private final String hostUuid;
+    private final String serial;
+    private final long routing;
+    private final long provisionedAtMillis;
+
+    private MacIdentity(String deviceId, String localUserUuid, String hostUuid, String serial,
+                        long routing, long provisionedAtMillis) {
+        this.deviceId = deviceId;
+        this.localUserUuid = localUserUuid;
+        this.hostUuid = hostUuid;
+        this.serial = serial;
+        this.routing = routing;
+        this.provisionedAtMillis = provisionedAtMillis;
+    }
+
+    /** A fresh, unprovisioned machine. Call once, {@link #save}, never call again. */
+    static MacIdentity generate() {
+        final SecureRandom random = new SecureRandom();
+        return new MacIdentity(
+                UDID_PREFIX + "-" + hex(random, 8).toUpperCase(Locale.ROOT),
+                hex(random, 16).toUpperCase(Locale.ROOT),
+                hex(random, 16),
+                AdiDeviceIdentity.generateSerial(random),
+                0,
+                0);
+    }
+
+    /** The stored identity, or null if this install has never had one. */
+    static MacIdentity load(File directory) throws IOException {
+        final File file = new File(directory, FILE);
+        if (!file.isFile()) {
+            return null;
+        }
+        try {
+            final JSONObject json = new JSONObject(
+                    new String(MacCoreAdiFetcher.readFile(file), StandardCharsets.UTF_8));
+            return new MacIdentity(
+                    json.getString("deviceId"),
+                    json.getString("localUserUuid"),
+                    json.getString("hostUuid"),
+                    json.getString("serial"),
+                    json.optLong("routing", 0),
+                    json.optLong("provisionedAtMillis", 0));
+        } catch (final JSONException e) {
+            throw new IOException("the emulated Mac's identity is unreadable", e);
+        }
+    }
+
+    void save(File directory) throws IOException {
+        if (!directory.isDirectory() && !directory.mkdirs()) {
+            throw new IOException("could not create " + directory);
+        }
+        final String text;
+        try {
+            text = new JSONObject()
+                    .put("deviceId", this.deviceId)
+                    .put("localUserUuid", this.localUserUuid)
+                    .put("hostUuid", this.hostUuid)
+                    .put("serial", this.serial)
+                    .put("routing", this.routing)
+                    .put("provisionedAtMillis", this.provisionedAtMillis)
+                    .toString(2);
+        } catch (final JSONException e) {
+            throw new IOException("could not describe the emulated Mac", e);
+        }
+        final File partial = new File(directory, FILE + ".partial");
+        try (FileOutputStream out = new FileOutputStream(partial)) {
+            out.write(text.getBytes(StandardCharsets.UTF_8));
+            out.getFD().sync();
+        }
+        if (!partial.renameTo(new File(directory, FILE))) {
+            throw new IOException("could not store the emulated Mac's identity");
+        }
+    }
+
+    /** This identity, provisioned, with the routing Apple assigned it. */
+    MacIdentity provisioned(long assignedRouting, long atMillis) {
+        return new MacIdentity(this.deviceId, this.localUserUuid, this.hostUuid, this.serial,
+                assignedRouting, atMillis);
+    }
+
+    /** {@code X-Mme-Device-Id}. */
+    public String deviceId() {
+        return this.deviceId;
+    }
+
+    /**
+     * The local user id. Sent raw at provisioning and as {@code base64} of this at login, by
+     * FindMy.py - which is what the reference does, and what Apple accepted.
+     */
+    public String localUserUuid() {
+        return this.localUserUuid;
+    }
+
+    /** What {@code gethostuuid} returns inside the emulator, as 32 hex characters. */
+    public String hostUuid() {
+        return this.hostUuid;
+    }
+
+    byte[] hostUuidBytes() {
+        final byte[] out = new byte[16];
+        for (int i = 0; i < 16; i++) {
+            out[i] = (byte) Integer.parseInt(this.hostUuid.substring(i * 2, i * 2 + 2), 16);
+        }
+        return out;
+    }
+
+    public String serial() {
+        return this.serial;
+    }
+
+    /** {@code X-Apple-I-MD-RINFO}, as Apple assigned it at provisioning. 0 before that. */
+    public long routing() {
+        return this.routing;
+    }
+
+    public long provisionedAtMillis() {
+        return this.provisionedAtMillis;
+    }
+
+    /** The six values FindMy.py's {@code DeviceIdentity.from_json} takes. See rule 11. */
+    static String hardwareJson() {
+        try {
+            return new JSONObject()
+                    .put("model", MODEL)
+                    .put("os_name", OS_NAME)
+                    .put("os_version", OS_VERSION)
+                    .put("os_build", OS_BUILD)
+                    .put("cfnetwork", CFNETWORK)
+                    .put("darwin", LOGIN_DARWIN)
+                    .toString();
+        } catch (final JSONException e) {
+            throw new IllegalStateException("could not describe the emulated Mac", e);
+        }
+    }
+
+    private static String hex(SecureRandom random, int bytes) {
+        final byte[] buffer = new byte[bytes];
+        random.nextBytes(buffer);
+        final StringBuilder out = new StringBuilder(bytes * 2);
+        for (final byte b : buffer) {
+            out.append(String.format("%02x", b));
+        }
+        return out.toString();
+    }
+}
diff --git a/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacProvisioning.java b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacProvisioning.java
new file mode 100644
index 0000000..1c7d89c
--- /dev/null
+++ b/app/src/main/java/dev/wander/android/opentagviewer/anisette/MacProvisioning.java
@@ -0,0 +1,237 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.TimeZone;
+
+/**
+ * Registering the emulated Mac with Apple: the same three requests as {@link AdiProvisioning},
+ * presented the way a Mac's {@code akd} presents them.
+ *
+ * <ol>
+ *   <li>GET the URL bag</li>
+ *   <li>POST {@code midStartProvisioning}, which answers the server's metadata (spim)</li>
+ *   <li>POST {@code midFinishProvisioning} with what the library made of it (cpim), which
+ *       answers a persistent token, a trust key and the machine's routing number</li>
+ * </ol>
+ *
+ * <p>The headers are copied from sacca97/os-findmy-e {@code tools/machoadi/gsa.py}, the
+ * configuration Apple has been seen to accept, and not tidied.
+ *
+ * <p><b>Apple allows one provisioning per device id.</b> A second answers HTTP 433 / -29002
+ * whatever else changes, so a failure after {@code midFinishProvisioning} succeeded cannot be
+ * retried with the same identity. That is why the caller saves the store and the identity the
+ * moment this returns.
+ */
+final class MacProvisioning {
+    private static final String TAG = "MacProvisioning";
+
+    static final String URL_BAG = "https://gsa.apple.com/grandslam/GsService2/lookup";
+
+    private static final String START_REQUEST =
+            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+            + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+            + "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+            + "<plist version=\"1.0\"><dict>"
+            + "<key>Header</key><dict/><key>Request</key><dict/>"
+            + "</dict></plist>";
+
+    private static final String FINISH_REQUEST =
+            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+            + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+            + "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+            + "<plist version=\"1.0\"><dict>"
+            + "<key>Header</key><dict/>"
+            + "<key>Request</key><dict><key>cpim</key><string>%s</string></dict>"
+            + "</dict></plist>";
+
+    private final MacIdentity identity;
+    private final MacAdi adi;
+    private final String urlBag;
+    private final Base64Codec base64;
+    private final PlistParser plists;
+
+    /**
+     * Reads a plist document. {@link SimplePlist#parse} in the app; on the JVM, where
+     * {@code android.util.Xml} is a stub, the tests supply one.
+     */
+    interface PlistParser {
+        Object parse(String xml) throws Exception;
+    }
+
+    MacProvisioning(MacIdentity identity, MacAdi adi) {
+        this(identity, adi, URL_BAG, Base64Codec.ANDROID, SimplePlist::parse);
+    }
+
+    /** @param urlBag where to ask for the provisioning endpoints; a local fake in the JVM tests */
+    MacProvisioning(MacIdentity identity, MacAdi adi, String urlBag, Base64Codec base64,
+                    PlistParser plists) {
+        this.identity = identity;
+        this.adi = adi;
+        this.urlBag = urlBag;
+        this.base64 = base64;
+        this.plists = plists;
+    }
+
+    /** @return the routing number Apple assigned the machine */
+    long provision() throws AdiProvisioning.ProvisioningException {
+        final Map<String, String> urls = loadUrlBag();
+        final String startUrl = urls.get("midStartProvisioning");
+        final String finishUrl = urls.get("midFinishProvisioning");
+        if (startUrl == null || finishUrl == null) {
+            throw new AdiProvisioning.ProvisioningException(
+                    "the URL bag has no provisioning endpoints. Got: " + urls.keySet());
+        }
+
+        final Object started = parse(request(startUrl, START_REQUEST), "midStartProvisioning");
+        final byte[] spim = decode(started, "spim");
+
+        final int[] session = new int[1];
+        final byte[] cpim;
+        try {
+            cpim = this.adi.provisioningBegin(MacAdi.ANONYMOUS_DS_ID, spim, session);
+        } catch (final IllegalStateException e) {
+            throw new AdiProvisioning.ProvisioningException(
+                    "the emulated Mac could not start provisioning: " + e.getMessage(), e);
+        }
+
+        final Object finished = parse(request(finishUrl, String.format(
+                FINISH_REQUEST, this.base64.encode(cpim))),
+                "midFinishProvisioning");
+        final byte[] persistentToken = decode(finished, "ptm");
+        final byte[] trustKey = decode(finished, "tk");
+        final String routingText = SimplePlist.string(finished, "Response", "X-Apple-I-MD-RINFO");
+        long routing = 0;
+        if (routingText != null && !routingText.isEmpty()) {
+            try {
+                routing = Long.parseLong(routingText.trim());
+            } catch (final NumberFormatException e) {
+                throw new AdiProvisioning.ProvisioningException(
+                        "Apple's routing number is not a number: " + routingText);
+            }
+        }
+
+        try {
+            this.adi.provisioningFinish(MacAdi.ANONYMOUS_DS_ID, session[0], persistentToken,
+                    trustKey, routing);
+        } catch (final IllegalStateException e) {
+            throw new AdiProvisioning.ProvisioningException(
+                    "the emulated Mac could not finish provisioning: " + e.getMessage(), e);
+        }
+        Log.i(TAG, "the emulated Mac is provisioned, routing " + routing);
+        return routing;
+    }
+
+    private Map<String, String> loadUrlBag() throws AdiProvisioning.ProvisioningException {
+        final Object plist = parse(request(this.urlBag, null), "the URL bag");
+        if (!(plist instanceof Map)) {
+            throw new AdiProvisioning.ProvisioningException("the URL bag is not a dictionary");
+        }
+        final Object urls = ((Map<?, ?>) plist).get("urls");
+        if (!(urls instanceof Map) || ((Map<?, ?>) urls).isEmpty()) {
+            throw new AdiProvisioning.ProvisioningException("the URL bag came back empty");
+        }
+        final Map<String, String> out = new HashMap<>();
+        for (final Map.Entry<?, ?> entry : ((Map<?, ?>) urls).entrySet()) {
+            if (entry.getValue() instanceof String) {
+                out.put(String.valueOf(entry.getKey()), (String) entry.getValue());
+            }
+        }
+        return out;
+    }
+
+    private Object parse(String body, String what)
+            throws AdiProvisioning.ProvisioningException {
+        try {
+            return this.plists.parse(body);
+        } catch (final Exception e) {
+            throw new AdiProvisioning.ProvisioningException("could not read " + what, e);
+        }
+    }
+
+    private byte[] decode(Object plist, String key)
+            throws AdiProvisioning.ProvisioningException {
+        final String value = SimplePlist.string(plist, "Response", key);
+        if (value == null) {
+            throw new AdiProvisioning.ProvisioningException("Apple's response has no Response/"
+                    + key + " - the request was refused, or the protocol has changed");
+        }
+        return this.base64.decode(value);
+    }
+
+    private String request(String url, String body) throws AdiProvisioning.ProvisioningException {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setConnectTimeout(30_000);
+            connection.setReadTimeout(30_000);
+            connection.setRequestProperty("User-Agent", MacIdentity.PROVISIONING_USER_AGENT);
+            // AuthKit really does label an XML plist body as a form.
+            connection.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+            connection.setRequestProperty("Connection", "keep-alive");
+            connection.setRequestProperty("Accept", "*/*");
+            connection.setRequestProperty("X-Mme-Device-Id", this.identity.deviceId());
+            connection.setRequestProperty("X-MMe-Client-Info", MacIdentity.CLIENT_INFO);
+            connection.setRequestProperty("X-Apple-I-MD-LU", this.identity.localUserUuid());
+            connection.setRequestProperty("X-Apple-Client-App-Name", "Setup");
+            connection.setRequestProperty("X-Apple-I-SRL-NO", this.identity.serial());
+
+            if (body != null) {
+                connection.setRequestProperty("X-Apple-I-Client-Time", now());
+                connection.setRequestMethod("POST");
+                connection.setDoOutput(true);
+                connection.getOutputStream().write(body.getBytes(StandardCharsets.UTF_8));
+            }
+
+            final int status = connection.getResponseCode();
+            final String response = readAll(status >= 400
+                    ? connection.getErrorStream() : connection.getInputStream());
+            if (status >= 400) {
+                throw new AdiProvisioning.ProvisioningException(
+                        "Apple returned HTTP " + status + " for " + url + ": " + response);
+            }
+            return response;
+        } catch (final AdiProvisioning.ProvisioningException e) {
+            throw e;
+        } catch (final IOException e) {
+            throw new AdiProvisioning.ProvisioningException("could not reach " + url + ": "
+                    + e.getClass().getSimpleName() + ": " + e.getMessage(), e);
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    /** ISO 8601, whole seconds. Apple rejects anything with milliseconds on it. */
+    private static String now() {
+        final SimpleDateFormat format =
+                new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.ROOT);
+        format.setTimeZone(TimeZone.getTimeZone("UTC"));
+        return format.format(new Date());
+    }
+
+    private static String readAll(InputStream stream) throws IOException {
+        if (stream == null) {
+            return "";
+        }
+        final ByteArrayOutputStream out = new ByteArrayOutputStream();
+        final byte[] buffer = new byte[8192];
+        int read;
+        while ((read = stream.read(buffer)) != -1) {
+            out.write(buffer, 0, read);
+        }
+        return out.toString("UTF-8");
+    }
+}
