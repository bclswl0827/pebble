+# Third-party notices for the emulated Mac
+
+## sacca97/os-findmy-e
+
+`macho.*`, `vm.*` and `core_adi.*` are a C++ port of
+[sacca97/os-findmy-e](https://github.com/sacca97/os-findmy-e) `native/adi-core/src/{macho,vm,adi}.rs`,
+and the provisioning headers in `MacProvisioning.java` and the identity shapes in `MacIdentity.java`
+follow its `tools/machoadi/{gsa,mac_anisette}.py`. Its licence:
+
+```
+MIT License
+
+Copyright (c) 2026 sacca
+
+Permission is hereby granted, free of charge, to any person obtaining a copy
+of this software and associated documentation files (the "Software"), to deal
+in the Software without restriction, including without limitation the rights
+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+copies of the Software, and to permit persons to whom the Software is
+furnished to do so, subject to the following conditions:
+
+The above copyright notice and this permission notice shall be included in all
+copies or substantial portions of the Software.
+
+THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+SOFTWARE.
+```
+
+## Unicorn
+
+[Unicorn](https://github.com/unicorn-engine/unicorn) 2.1.4 is fetched from source at build time
+(`MacAdi.cmake`, pinned by SHA-256) and linked into `libmacadi.so`. It is licensed under
+**GPL-2.0**, so an APK containing `libmacadi.so` contains GPL-2.0 code.
+
+What that obliges, and where each part is done:
+
+- **The licence and a notice travel with the APK**: `app/src/main/assets/licences/unicorn/` holds
+  Unicorn's own `COPYING` (GPL-2.0), its QEMU licence files, and `NOTICE.txt`, which says where the
+  corresponding source is. `UnicornNoticeTest` fails if the version or hash there stops matching
+  `MacAdi.cmake`.
+- **The corresponding source is offered from the same place as the binary**: `build-release.yml`
+  attaches the exact Unicorn tarball, checked against the pinned hash, to the release.
+- **It is a separate program**: `libmacadi.so` is loaded only in the `:macadi` process, by
+  `MacAdiService`, and the app reaches it over binder (`RemoteMacAdi`). See
+  `docs/emulated-mac-emulator-choice.md`.
+
+## Apple's CoreADI
+
+Not part of this repository or of any build. The app downloads it at runtime from Apple's own
+server - see `MacCoreAdiFetcher.java` and `scripts/locate_mac_coreadi.py`.
diff --git a/app/src/main/cpp/macadi/core_adi.cpp b/app/src/main/cpp/macadi/core_adi.cpp
new file mode 100644
index 0000000..cc2c2e6
--- /dev/null
+++ b/app/src/main/cpp/macadi/core_adi.cpp
@@ -0,0 +1,231 @@
+#include "core_adi.h"
+
+#include <algorithm>
+
+#include "error.h"
+
+namespace macadi {
+namespace {
+
+constexpr uint32_t INITIALIZE = 0x12DB31C5;
+constexpr uint32_t IS_MACHINE_PROVISIONED = 0xB0EDA7AF;
+constexpr uint32_t PROVISIONING_START = 0x716BD86C;
+constexpr uint32_t PROVISIONING_END = 0x0B2B3196;
+constexpr uint32_t SET_IDMS_ROUTING = 0x632B8D6E;
+constexpr uint32_t GET_IDMS_ROUTING = 0x85FE63B0;
+constexpr uint32_t SYNCHRONIZE = 0xA54951EC;
+constexpr uint32_t REQUEST_OTP = 0xCFE0B46A;
+constexpr uint32_t STORAGE_DISPOSE = 0x3E58E7F9;
+
+void be32(std::vector<uint8_t> &m, uint32_t v) {
+    for (int s = 24; s >= 0; s -= 8) m.push_back(static_cast<uint8_t>(v >> s));
+}
+
+void be64(std::vector<uint8_t> &m, uint64_t v) {
+    for (int s = 56; s >= 0; s -= 8) m.push_back(static_cast<uint8_t>(v >> s));
+}
+
+std::vector<uint8_t> dsIdMessage(int64_t dsId) {
+    std::vector<uint8_t> m;
+    be64(m, static_cast<uint64_t>(dsId));
+    return m;
+}
+
+const std::string LEGACY_STORE = "adi.pb";
+
+}  // namespace
+
+CoreAdi::CoreAdi(const std::vector<uint8_t> &image, uint64_t dispatch)
+    : vm_(image), dispatch_(dispatch) {}
+
+void CoreAdi::check(const char *op, Reply r) {
+    if (r.rc < 0 || r.ret < 0) {
+        throw Error(std::string("adi: ") + op + " failed: " +
+                    std::to_string(r.ret < 0 ? r.ret : r.rc));
+    }
+}
+
+CoreAdi::Reply CoreAdi::call(uint32_t code, const std::vector<uint8_t> &message) {
+    std::vector<uint8_t> buf(std::max<size_t>(0x800, 8 + message.size()), 0);
+    buf[3] = 1;  // encryption type: clear
+    buf[7] = 1;
+    std::copy(message.begin(), message.end(), buf.begin() + 8);
+    const uint64_t bufAddr = vm_.scratch(buf.size());
+    vm_.write(bufAddr, buf);
+
+    const uint64_t params = vm_.scratch(0x20);
+    vm_.write(params, std::vector<uint8_t>(0x20, 0));
+    vm_.writeU64(params, bufAddr);
+    vm_.writeU32(params + 0x08, static_cast<uint32_t>(8 + message.size()));
+    vm_.writeU32(params + 0x0C, 4);
+    vm_.writeU32(params + 0x10, 0);
+
+    const int32_t rc = static_cast<int32_t>(static_cast<uint32_t>(vm_.invoke(dispatch_, {code, params})));
+    const std::vector<uint8_t> head = vm_.read(bufAddr, 4);
+    const int32_t ret = static_cast<int32_t>((static_cast<uint32_t>(head[0]) << 24) |
+                                             (static_cast<uint32_t>(head[1]) << 16) |
+                                             (static_cast<uint32_t>(head[2]) << 8) |
+                                             static_cast<uint32_t>(head[3]));
+    vm_.write(bufAddr + 4, std::vector<uint8_t>(4, 0));
+    return Reply{rc, ret};
+}
+
+uint64_t CoreAdi::cell(uint64_t v) {
+    const uint64_t a = vm_.scratch(8);
+    vm_.writeU64(a, v);
+    return a;
+}
+
+uint64_t CoreAdi::input(const std::vector<uint8_t> &data) {
+    const uint64_t a = vm_.scratch(std::max<size_t>(data.size(), 16));
+    vm_.write(a, data);
+    return a;
+}
+
+std::vector<uint8_t> CoreAdi::slice(uint64_t ptr, uint64_t len) {
+    const uint64_t p = vm_.readU64(ptr);
+    const uint32_t n = vm_.readU32(len);
+    if (p == 0 || n == 0) return {};
+    return vm_.read(p, n);
+}
+
+void CoreAdi::beginSession() {
+    // Provisioning writes the legacy whole-machine blob as well as the per-user one, and while it
+    // is present the library reports the machine unprovisioned (see storePut). A process that
+    // restarts never sees it, because storePut refuses it; one that provisions and then asks for
+    // headers in the same process would, and sent Apple an empty machine id (ec -80009). So it
+    // goes before every session, not only on load.
+    vm_.files().erase(std::string(STORE_DIR) + "/" + LEGACY_STORE);
+    rawBeginSession();
+}
+
+CoreAdi::Reply CoreAdi::rawBeginSession() {
+    vm_.resetSession();
+    return initialize();
+}
+
+CoreAdi::Reply CoreAdi::initialize() {
+    vm_.scratchReset();
+    return call(INITIALIZE, {});
+}
+
+CoreAdi::Reply CoreAdi::isMachineProvisioned(int64_t dsId) {
+    vm_.scratchReset();
+    return call(IS_MACHINE_PROVISIONED, dsIdMessage(dsId));
+}
+
+CoreAdi::Otp CoreAdi::requestOtp(int64_t dsId) {
+    vm_.scratchReset();
+    const uint64_t midP = cell(0), midL = cell(0), otpP = cell(0), otpL = cell(0);
+    std::vector<uint8_t> m = dsIdMessage(dsId);
+    for (const uint64_t v : {midP, midL, otpP, otpL}) be64(m, v);
+    const Reply reply = call(REQUEST_OTP, m);
+    Otp out{reply, slice(midP, midL), slice(otpP, otpL)};
+    // The library hands back pointers into its own storage; release them.
+    if (!out.mid.empty() && !out.otp.empty()) storageDispose(vm_.readU64(midP));
+    return out;
+}
+
+std::pair<CoreAdi::Reply, uint64_t> CoreAdi::getRouting(int64_t dsId) {
+    vm_.scratchReset();
+    const uint64_t routingCell = cell(0);
+    std::vector<uint8_t> r = dsIdMessage(dsId);
+    be64(r, routingCell);
+    const Reply reply = call(GET_IDMS_ROUTING, r);
+    return {reply, vm_.readU64(routingCell)};
+}
+
+CoreAdi::ProvisioningStart CoreAdi::provisioningStart(int64_t dsId,
+                                                      const std::vector<uint8_t> &spim) {
+    vm_.scratchReset();
+    const uint64_t spimBuf = input(spim);
+    const uint64_t cpimP = cell(0), cpimL = cell(0), session = cell(0);
+    std::vector<uint8_t> m = dsIdMessage(dsId);
+    be64(m, spimBuf);
+    be32(m, static_cast<uint32_t>(spim.size()));
+    for (const uint64_t v : {cpimP, cpimL, session}) be64(m, v);
+    const Reply reply = call(PROVISIONING_START, m);
+    return {reply, slice(cpimP, cpimL), vm_.readU32(session)};
+}
+
+CoreAdi::Reply CoreAdi::storageDispose(uint64_t ptr) {
+    std::vector<uint8_t> m;
+    be64(m, ptr);
+    return call(STORAGE_DISPOSE, m);
+}
+
+CoreAdi::Reply CoreAdi::setRouting(int64_t dsId, uint64_t routing) {
+    vm_.scratchReset();
+    std::vector<uint8_t> m = dsIdMessage(dsId);
+    be64(m, routing);
+    return call(SET_IDMS_ROUTING, m);
+}
+
+void CoreAdi::storePut(const std::string &name, const std::vector<uint8_t> &data) {
+    // The legacy whole-machine blob is never restored: whenever it is present, the library
+    // reports the machine unprovisioned without reading the per-user one (os-findmy-e,
+    // mac_anisette.py). Restoring it would make every later session look unprovisioned.
+    if (name == LEGACY_STORE) return;
+    vm_.files()[std::string(STORE_DIR) + "/" + name] = data;
+}
+
+std::vector<std::pair<std::string, std::vector<uint8_t>>> CoreAdi::storeFiles() {
+    const std::string prefix = std::string(STORE_DIR) + "/";
+    std::vector<std::pair<std::string, std::vector<uint8_t>>> out;
+    for (const auto &f : vm_.files()) {
+        if (f.first.rfind(prefix, 0) == 0) out.emplace_back(f.first.substr(prefix.size()), f.second);
+    }
+    return out;
+}
+
+Headers CoreAdi::headers(int64_t dsId) {
+    beginSession();
+    if (isMachineProvisioned(dsId).ret != 0) throw NotProvisioned();
+
+    const Otp otp = requestOtp(dsId);
+    check("RequestOTP", otp.reply);
+
+    const std::pair<Reply, uint64_t> routing = getRouting(dsId);
+    check("GetIDMSRouting", routing.first);
+    return Headers{otp.mid, otp.otp, routing.second};
+}
+
+std::pair<std::vector<uint8_t>, uint32_t> CoreAdi::provisioningBegin(
+        int64_t dsId, const std::vector<uint8_t> &spim) {
+    beginSession();
+    if (isMachineProvisioned(dsId).ret == 0) throw AlreadyProvisioned();
+
+    const ProvisioningStart started = provisioningStart(dsId, spim);
+    check("ProvisioningStart", started.reply);
+    return {started.cpim, started.session};
+}
+
+void CoreAdi::provisioningFinish(int64_t dsId, uint32_t session, const std::vector<uint8_t> &ptm,
+                                 const std::vector<uint8_t> &tk, uint64_t routing) {
+    vm_.scratchReset();
+    const uint64_t ptmBuf = input(ptm), tkBuf = input(tk);
+    std::vector<uint8_t> m;
+    be32(m, session);
+    be64(m, ptmBuf);
+    be32(m, static_cast<uint32_t>(ptm.size()));
+    be64(m, tkBuf);
+    be32(m, static_cast<uint32_t>(tk.size()));
+    check("ProvisioningEnd", call(PROVISIONING_END, m));
+    check("SetIDMSRouting", setRouting(dsId, routing));
+}
+
+std::pair<std::vector<uint8_t>, std::vector<uint8_t>> CoreAdi::sync(
+        int64_t dsId, const std::vector<uint8_t> &sim) {
+    beginSession();
+    vm_.scratchReset();
+    const uint64_t simBuf = input(sim);
+    const uint64_t midP = cell(0), midL = cell(0), srmP = cell(0), srmL = cell(0);
+    std::vector<uint8_t> m = dsIdMessage(dsId);
+    be64(m, simBuf);
+    be32(m, static_cast<uint32_t>(sim.size()));
+    for (const uint64_t v : {midP, midL, srmP, srmL}) be64(m, v);
+    check("Synchronize", call(SYNCHRONIZE, m));
+    return {slice(midP, midL), slice(srmP, srmL)};
+}
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/core_adi.h b/app/src/main/cpp/macadi/core_adi.h
new file mode 100644
index 0000000..6e74ca8
--- /dev/null
+++ b/app/src/main/cpp/macadi/core_adi.h
@@ -0,0 +1,108 @@
+// The CoreADI dispatcher, `_vdfut768ig(function_code, CoreADIParameters *)`, and the handful of
+// operations Anisette needs from it.
+//
+// Requests are big-endian; pointers inside a message are 8-byte big-endian addresses *inside the
+// emulated process*. After Dadoum/apple-crates adi/src/{core_adi,calls}.rs, by way of
+// sacca97/os-findmy-e native/adi-core/src/adi.rs (MIT), which this ports.
+//
+// **One high-level call is one session.** Each starts by putting the VM back to its post-load
+// state and calling Initialize, the way a fresh process would. Nothing accumulates between calls,
+// which is what lets a bump allocator stand in for malloc. The one exception is provisioning:
+// provisioningBegin and provisioningFinish must share a session, with nothing in between.
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "vm.h"
+
+namespace macadi {
+
+struct Headers {
+    std::vector<uint8_t> mid;  // X-Apple-I-MD-M, raw
+    std::vector<uint8_t> otp;  // X-Apple-I-MD, raw
+    uint64_t routing;          // X-Apple-I-MD-RINFO
+};
+
+class CoreAdi {
+public:
+    // `dispatch` is the offset of _vdfut768ig in this build. Java knows it, by the build's sha256,
+    // and refuses any file it does not recognise before this is ever called.
+    CoreAdi(const std::vector<uint8_t> &image, uint64_t dispatch);
+
+    void setHostUuid(const uint8_t uuid[16]) { vm_.setHostUuid(uuid); }
+    void setFrozenTime(int64_t secs) { vm_.setFrozenTime(secs); }
+
+    // The store, as (file name, bytes). Persist it after every call that can change it - which is
+    // every call, since RequestOTP rewrites it.
+    void storePut(const std::string &name, const std::vector<uint8_t> &data);
+    std::vector<std::pair<std::string, std::vector<uint8_t>>> storeFiles();
+
+    // One session: what a machine puts on one request.
+    Headers headers(int64_t dsId);
+
+    // Start provisioning with Apple's spim; returns (cpim, session).
+    std::pair<std::vector<uint8_t>, uint32_t> provisioningBegin(int64_t dsId,
+                                                                const std::vector<uint8_t> &spim);
+    // Finish with what Apple returned for the cpim. Same session as provisioningBegin.
+    void provisioningFinish(int64_t dsId, uint32_t session, const std::vector<uint8_t> &ptm,
+                            const std::vector<uint8_t> &tk, uint64_t routing);
+
+    // Answer Apple's resync request (a 434 carrying X-Apple-I-MD-DATA): returns (mid, srm).
+    std::pair<std::vector<uint8_t>, std::vector<uint8_t>> sync(int64_t dsId,
+                                                               const std::vector<uint8_t> &sim);
+
+    // ---- The raw calls, one dispatcher call each, for scripts/adi-emulator-diff/ ----------------
+    //
+    // These are the operations os-findmy-e's adi-core exposes, with the same inputs and the same
+    // outputs, so its offline driver can be replayed here call for call and the two printed side by
+    // side (app/src/test/macadi-host/macadi_diff.cpp). The high-level calls above are built from
+    // them, so the comparison covers the code the app runs.
+    struct Reply {
+        int32_t rc;   // the dispatcher's status
+        int32_t ret;  // the operation's own, negative on failure
+    };
+    struct Otp {
+        Reply reply;
+        std::vector<uint8_t> mid;
+        std::vector<uint8_t> otp;
+    };
+    struct ProvisioningStart {
+        Reply reply;
+        std::vector<uint8_t> cpim;
+        uint32_t session;
+    };
+
+    // adi-core's begin_session: back to the post-load state, then Initialize. Unlike the app's
+    // beginSession it leaves adi.pb in place, as adi-core does - see beginSession for why the app
+    // removes it.
+    Reply rawBeginSession();
+    Reply isMachineProvisioned(int64_t dsId);
+    Otp requestOtp(int64_t dsId);
+    std::pair<Reply, uint64_t> getRouting(int64_t dsId);
+    ProvisioningStart provisioningStart(int64_t dsId, const std::vector<uint8_t> &spim);
+
+    // Every file in the virtual filesystem, by full path, as adi-core's Vm::files().
+    const std::map<std::string, std::vector<uint8_t>> &vmFiles() { return vm_.files(); }
+
+private:
+    void beginSession();
+    Reply call(uint32_t code, const std::vector<uint8_t> &message);
+    uint64_t cell(uint64_t v);
+    uint64_t input(const std::vector<uint8_t> &data);
+    std::vector<uint8_t> slice(uint64_t ptr, uint64_t len);
+    static void check(const char *op, Reply r);
+
+    Reply initialize();
+    Reply storageDispose(uint64_t ptr);
+    Reply setRouting(int64_t dsId, uint64_t routing);
+
+    Vm vm_;
+    uint64_t dispatch_;
+};
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/error.h b/app/src/main/cpp/macadi/error.h
new file mode 100644
index 0000000..e9b70ed
--- /dev/null
+++ b/app/src/main/cpp/macadi/error.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <stdexcept>
+#include <string>
+
+namespace macadi {
+
+// Everything this library can fail with. The message is what reaches Java, and through it the
+// log the user is asked to attach, so it says which layer failed: the Mach-O, the emulation, or
+// Apple's library answering with an error of its own.
+class Error : public std::runtime_error {
+public:
+    explicit Error(const std::string &message) : std::runtime_error(message) {}
+};
+
+// The library is not provisioned yet. Distinct because it is the one failure that has a remedy:
+// provisioning.
+class NotProvisioned : public Error {
+public:
+    NotProvisioned() : Error("the machine is not provisioned") {}
+};
+
+class AlreadyProvisioned : public Error {
+public:
+    AlreadyProvisioned() : Error("the machine is already provisioned") {}
+};
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/jni.cpp b/app/src/main/cpp/macadi/jni.cpp
new file mode 100644
index 0000000..734bab7
--- /dev/null
+++ b/app/src/main/cpp/macadi/jni.cpp
@@ -0,0 +1,172 @@
+// JNI face of the emulated Mac: dev.wander.android.opentagviewer.anisette.MacCoreAdi.
+//
+// A handle is a CoreAdi* passed to Java as a long. Java owns its lifetime and uses it from one
+// thread at a time, under its own lock. Every native failure becomes an IllegalStateException
+// carrying the C++ message, except "not provisioned", which has its own type because it is the
+// one failure with a remedy.
+
+#include <jni.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "core_adi.h"
+#include "error.h"
+
+namespace {
+
+constexpr const char *STATE_EXCEPTION = "java/lang/IllegalStateException";
+constexpr const char *NOT_PROVISIONED =
+        "dev/wander/android/opentagviewer/anisette/MacAdi$NotProvisionedException";
+
+macadi::CoreAdi *adi(jlong handle) { return reinterpret_cast<macadi::CoreAdi *>(handle); }
+
+std::vector<uint8_t> bytes(JNIEnv *env, jbyteArray array) {
+    if (array == nullptr) return {};
+    const jsize n = env->GetArrayLength(array);
+    std::vector<uint8_t> out(static_cast<size_t>(n));
+    if (n > 0) env->GetByteArrayRegion(array, 0, n, reinterpret_cast<jbyte *>(out.data()));
+    return out;
+}
+
+jbyteArray array(JNIEnv *env, const std::vector<uint8_t> &data) {
+    jbyteArray out = env->NewByteArray(static_cast<jsize>(data.size()));
+    if (out != nullptr && !data.empty()) {
+        env->SetByteArrayRegion(out, 0, static_cast<jsize>(data.size()),
+                                reinterpret_cast<const jbyte *>(data.data()));
+    }
+    return out;
+}
+
+void raise(JNIEnv *env, const char *type, const char *message) {
+    jclass cls = env->FindClass(type);
+    if (cls != nullptr) env->ThrowNew(cls, message);
+}
+
+// Runs `body`, turning any C++ exception into a Java one. Nothing may unwind past a JNI frame.
+template <typename T, typename F>
+T guarded(JNIEnv *env, T onError, F body) {
+    try {
+        return body();
+    } catch (const macadi::NotProvisioned &e) {
+        raise(env, NOT_PROVISIONED, e.what());
+    } catch (const std::exception &e) {
+        raise(env, STATE_EXCEPTION, e.what());
+    } catch (...) {
+        raise(env, STATE_EXCEPTION, "unknown native failure");
+    }
+    return onError;
+}
+
+}  // namespace
+
+extern "C" {
+
+JNIEXPORT jlong JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeOpen(
+        JNIEnv *env, jclass, jbyteArray image, jlong dispatch) {
+    return guarded<jlong>(env, 0, [&]() {
+        auto opened = std::make_unique<macadi::CoreAdi>(bytes(env, image),
+                                                        static_cast<uint64_t>(dispatch));
+        return reinterpret_cast<jlong>(opened.release());
+    });
+}
+
+JNIEXPORT void JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeClose(JNIEnv *, jclass,
+                                                                      jlong handle) {
+    delete adi(handle);
+}
+
+JNIEXPORT void JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeSetHostUuid(
+        JNIEnv *env, jclass, jlong handle, jbyteArray uuid) {
+    guarded<int>(env, 0, [&]() {
+        const std::vector<uint8_t> raw = bytes(env, uuid);
+        if (raw.size() != 16) throw macadi::Error("a host UUID is 16 bytes");
+        adi(handle)->setHostUuid(raw.data());
+        return 0;
+    });
+}
+
+JNIEXPORT void JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeSetFrozenTime(
+        JNIEnv *, jclass, jlong handle, jlong secs) {
+    adi(handle)->setFrozenTime(secs);
+}
+
+JNIEXPORT void JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeStorePut(
+        JNIEnv *env, jclass, jlong handle, jstring name, jbyteArray data) {
+    guarded<int>(env, 0, [&]() {
+        const char *chars = env->GetStringUTFChars(name, nullptr);
+        const std::string n = chars == nullptr ? std::string() : chars;
+        if (chars != nullptr) env->ReleaseStringUTFChars(name, chars);
+        adi(handle)->storePut(n, bytes(env, data));
+        return 0;
+    });
+}
+
+// The store as alternating {name bytes (UTF-8), contents} entries.
+JNIEXPORT jobjectArray JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeStoreFiles(JNIEnv *env, jclass,
+                                                                           jlong handle) {
+    return guarded<jobjectArray>(env, nullptr, [&]() -> jobjectArray {
+        const auto files = adi(handle)->storeFiles();
+        jclass bytesClass = env->FindClass("[B");
+        jobjectArray out = env->NewObjectArray(static_cast<jsize>(files.size() * 2), bytesClass, nullptr);
+        if (out == nullptr) return nullptr;
+        for (size_t i = 0; i < files.size(); i++) {
+            const std::vector<uint8_t> name(files[i].first.begin(), files[i].first.end());
+            jbyteArray n = array(env, name);
+            jbyteArray c = array(env, files[i].second);
+            env->SetObjectArrayElement(out, static_cast<jsize>(i * 2), n);
+            env->SetObjectArrayElement(out, static_cast<jsize>(i * 2 + 1), c);
+            env->DeleteLocalRef(n);
+            env->DeleteLocalRef(c);
+        }
+        return out;
+    });
+}
+
+// {mid, otp}; routing goes into routingOut[0].
+JNIEXPORT jobjectArray JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeHeaders(
+        JNIEnv *env, jclass, jlong handle, jlong dsId, jlongArray routingOut) {
+    return guarded<jobjectArray>(env, nullptr, [&]() -> jobjectArray {
+        const macadi::Headers h = adi(handle)->headers(dsId);
+        const jlong routing = static_cast<jlong>(h.routing);
+        env->SetLongArrayRegion(routingOut, 0, 1, &routing);
+        jobjectArray out = env->NewObjectArray(2, env->FindClass("[B"), nullptr);
+        if (out == nullptr) return nullptr;
+        env->SetObjectArrayElement(out, 0, array(env, h.mid));
+        env->SetObjectArrayElement(out, 1, array(env, h.otp));
+        return out;
+    });
+}
+
+// The cpim; the session goes into sessionOut[0].
+JNIEXPORT jbyteArray JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeProvisioningBegin(
+        JNIEnv *env, jclass, jlong handle, jlong dsId, jbyteArray spim, jintArray sessionOut) {
+    return guarded<jbyteArray>(env, nullptr, [&]() {
+        const auto started = adi(handle)->provisioningBegin(dsId, bytes(env, spim));
+        const jint session = static_cast<jint>(started.second);
+        env->SetIntArrayRegion(sessionOut, 0, 1, &session);
+        return array(env, started.first);
+    });
+}
+
+JNIEXPORT void JNICALL
+Java_dev_wander_android_opentagviewer_anisette_MacCoreAdi_nativeProvisioningFinish(
+        JNIEnv *env, jclass, jlong handle, jlong dsId, jint session, jbyteArray ptm,
+        jbyteArray tk, jlong routing) {
+    guarded<int>(env, 0, [&]() {
+        adi(handle)->provisioningFinish(dsId, static_cast<uint32_t>(session), bytes(env, ptm),
+                                        bytes(env, tk), static_cast<uint64_t>(routing));
+        return 0;
+    });
+}
+
+}  // extern "C"
diff --git a/app/src/main/cpp/macadi/macho.cpp b/app/src/main/cpp/macadi/macho.cpp
new file mode 100644
index 0000000..cd40177
--- /dev/null
+++ b/app/src/main/cpp/macadi/macho.cpp
@@ -0,0 +1,178 @@
+#include "macho.h"
+
+#include <cstring>
+#include <unordered_set>
+
+#include "error.h"
+
+namespace macadi {
+namespace {
+
+constexpr uint32_t MH_MAGIC_64 = 0xFEEDFACF;
+constexpr uint32_t LC_SEGMENT_64 = 0x19;
+constexpr uint32_t LC_DYLD_INFO = 0x22;
+constexpr uint32_t LC_DYLD_INFO_ONLY = 0x80000022;
+
+uint32_t u32At(const std::vector<uint8_t> &d, size_t o) {
+    if (o + 4 > d.size()) throw Error("mach-o: truncated");
+    uint32_t v;
+    std::memcpy(&v, d.data() + o, 4);
+    return v;  // little-endian host on every ABI this is built for
+}
+
+uint64_t u64At(const std::vector<uint8_t> &d, size_t o) {
+    if (o + 8 > d.size()) throw Error("mach-o: truncated");
+    uint64_t v;
+    std::memcpy(&v, d.data() + o, 8);
+    return v;
+}
+
+uint64_t uleb(const std::vector<uint8_t> &d, size_t &o) {
+    uint64_t v = 0;
+    unsigned shift = 0;
+    for (;;) {
+        if (o >= d.size()) throw Error("mach-o: truncated leb");
+        const uint8_t b = d[o++];
+        if (shift < 64) v |= static_cast<uint64_t>(b & 0x7F) << shift;
+        shift += 7;
+        if ((b & 0x80) == 0) return v;
+    }
+}
+
+int64_t sleb(const std::vector<uint8_t> &d, size_t &o) {
+    int64_t v = 0;
+    unsigned shift = 0;
+    for (;;) {
+        if (o >= d.size()) throw Error("mach-o: truncated leb");
+        const uint8_t b = d[o++];
+        if (shift < 64) v |= static_cast<int64_t>(b & 0x7F) << shift;
+        shift += 7;
+        if ((b & 0x80) == 0) {
+            if (shift < 64 && (b & 0x40) != 0) v |= -(static_cast<int64_t>(1) << shift);
+            return v;
+        }
+    }
+}
+
+}  // namespace
+
+MachO MachO::parse(const std::vector<uint8_t> &d) {
+    if (u32At(d, 0) != MH_MAGIC_64) throw Error("mach-o: not a thin 64-bit Mach-O");
+    const uint32_t ncmds = u32At(d, 16);
+
+    MachO m;
+    size_t bindOff = 0, bindLen = 0, lazyOff = 0, lazyLen = 0;
+    size_t off = 32;
+    for (uint32_t i = 0; i < ncmds; i++) {
+        const uint32_t cmd = u32At(d, off);
+        const uint32_t size = u32At(d, off + 4);
+        if (cmd == LC_SEGMENT_64) {
+            m.segments_.push_back(Segment{
+                    u64At(d, off + 24), u64At(d, off + 32), u64At(d, off + 40),
+                    u64At(d, off + 48), (u32At(d, off + 60) & 2) != 0});
+        } else if (cmd == LC_DYLD_INFO || cmd == LC_DYLD_INFO_ONLY) {
+            bindOff = u32At(d, off + 16);
+            bindLen = u32At(d, off + 20);
+            lazyOff = u32At(d, off + 32);
+            lazyLen = u32At(d, off + 36);
+        }
+        if (size == 0) throw Error("mach-o: zero-sized load command");
+        off += size;
+    }
+
+    std::vector<Bind> binds = m.readBinds(d, bindOff, bindLen, false);
+    std::vector<Bind> lazy = m.readBinds(d, lazyOff, lazyLen, true);
+    binds.insert(binds.end(), lazy.begin(), lazy.end());
+    m.binds_ = std::move(binds);
+    return m;
+}
+
+std::vector<Bind> MachO::readBinds(const std::vector<uint8_t> &d, size_t start, size_t len,
+                                   bool lazy) const {
+    std::vector<Bind> out;
+    if (len == 0) return out;
+    if (start + len > d.size()) throw Error("mach-o: bind stream outside the file");
+
+    const size_t end = start + len;
+    size_t o = start;
+    std::string symbol;
+    int64_t addend = 0;
+    size_t seg = 0;
+    uint64_t segOff = 0;
+
+    auto push = [&]() {
+        if (seg >= segments_.size()) throw Error("mach-o: bad bind segment");
+        out.push_back(Bind{segments_[seg].vmaddr + segOff, symbol, addend});
+    };
+
+    while (o < end) {
+        const uint8_t byte = d[o++];
+        const uint8_t op = byte & 0xF0;
+        const uint64_t imm = byte & 0x0F;
+        switch (op) {
+            case 0x00:  // DONE - but lazy streams carry one per entry, so keep going there
+                if (!lazy) return out;
+                break;
+            case 0x10:  // SET_DYLIB_ORDINAL_IMM
+            case 0x30:  // SET_DYLIB_SPECIAL_IMM
+            case 0x50:  // SET_TYPE_IMM
+                break;
+            case 0x20:  // SET_DYLIB_ORDINAL_ULEB
+                uleb(d, o);
+                break;
+            case 0x40: {  // SET_SYMBOL_TRAILING_FLAGS_IMM
+                const void *nul = std::memchr(d.data() + o, 0, end - o);
+                if (nul == nullptr) throw Error("mach-o: bad symbol");
+                const size_t z = static_cast<const uint8_t *>(nul) - (d.data() + o);
+                symbol.assign(reinterpret_cast<const char *>(d.data() + o), z);
+                o += z + 1;
+                break;
+            }
+            case 0x60:  // SET_ADDEND_SLEB
+                addend = sleb(d, o);
+                break;
+            case 0x70:  // SET_SEGMENT_AND_OFFSET_ULEB
+                seg = static_cast<size_t>(imm);
+                segOff = uleb(d, o);
+                break;
+            case 0x80:  // ADD_ADDR_ULEB
+                segOff += uleb(d, o);
+                break;
+            case 0x90:  // DO_BIND
+                push();
+                segOff += 8;
+                break;
+            case 0xA0:  // DO_BIND_ADD_ADDR_ULEB
+                push();
+                segOff += uleb(d, o) + 8;
+                break;
+            case 0xB0:  // DO_BIND_ADD_ADDR_IMM_SCALED
+                push();
+                segOff += imm * 8 + 8;
+                break;
+            case 0xC0: {  // DO_BIND_ULEB_TIMES_SKIPPING_ULEB
+                const uint64_t count = uleb(d, o);
+                const uint64_t skip = uleb(d, o);
+                for (uint64_t i = 0; i < count; i++) {
+                    push();
+                    segOff += skip + 8;
+                }
+                break;
+            }
+            default:
+                throw Error("mach-o: unsupported bind opcode " + std::to_string(op));
+        }
+    }
+    return out;
+}
+
+std::vector<std::string> MachO::bindSymbols() const {
+    std::vector<std::string> out;
+    std::unordered_set<std::string> seen;
+    for (const Bind &b : binds_) {
+        if (seen.insert(b.symbol).second) out.push_back(b.symbol);
+    }
+    return out;
+}
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/macho.h b/app/src/main/cpp/macadi/macho.h
new file mode 100644
index 0000000..818bcf7
--- /dev/null
+++ b/app/src/main/cpp/macadi/macho.h
@@ -0,0 +1,50 @@
+// A minimal reader for the one Mach-O this library loads: Apple's CoreADI, x86_64 slice, as it
+// ships in iTunes 12.8.3 for Mac. Segments to map and the dyld bind stream to stub - nothing else.
+//
+// Classic LC_DYLD_INFO only. The builds this is for predate chained fixups, and a build that used
+// them would be refused by the sha256 check in Java long before it got here.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace macadi {
+
+struct Segment {
+    uint64_t vmaddr;
+    uint64_t vmsize;
+    uint64_t fileoff;
+    uint64_t filesize;
+    bool writable;
+};
+
+struct Bind {
+    uint64_t address;
+    std::string symbol;
+    int64_t addend;
+};
+
+class MachO {
+public:
+    // Throws macadi::Error on anything that is not a thin little-endian 64-bit Mach-O with a
+    // bind stream this reader understands.
+    static MachO parse(const std::vector<uint8_t> &image);
+
+    const std::vector<Segment> &segments() const { return segments_; }
+    const std::vector<Bind> &binds() const { return binds_; }
+
+    // Distinct imported symbols, in first-seen order: binds, then lazy binds. The index of a symbol
+    // in this list is what places its stub, so the order is part of the memory layout.
+    std::vector<std::string> bindSymbols() const;
+
+private:
+    std::vector<Bind> readBinds(const std::vector<uint8_t> &d, size_t start, size_t len,
+                                bool lazy) const;
+
+    std::vector<Segment> segments_;
+    std::vector<Bind> binds_;
+};
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/vm.cpp b/app/src/main/cpp/macadi/vm.cpp
new file mode 100644
index 0000000..e53c2e4
--- /dev/null
+++ b/app/src/main/cpp/macadi/vm.cpp
@@ -0,0 +1,663 @@
+#include "vm.h"
+
+#include <algorithm>
+#include <cstring>
+#include <ctime>
+
+#include "error.h"
+#include "macho.h"
+
+namespace macadi {
+
+const char *const STORE_DIR = "/Users/Shared/adi";
+
+namespace {
+
+constexpr uint64_t PAGE = 0x1000;
+constexpr uint64_t RETURN_ADDRESS = 0x40000000;
+constexpr uint64_t HEAP_ADDRESS = 0x40010000;
+constexpr uint64_t HEAP_SIZE = 0x01000000;
+constexpr uint64_t STACK_ADDRESS = 0x50000000;
+constexpr uint64_t STACK_SIZE = 0x00200000;
+constexpr uint64_t STUB_ADDRESS = 0x60000000;
+constexpr uint64_t STUB_SIZE = 0x20000;
+constexpr uint64_t DATA_ADDRESS = 0x60020000;
+constexpr uint64_t DATA_SIZE = 0x20000;
+constexpr uint64_t SCRATCH_ADDRESS = 0x60040000;
+constexpr uint64_t SCRATCH_SIZE = 0x40000;
+constexpr uint64_t OBJECT_ADDRESS = 0x60080000;
+constexpr uint64_t OBJECT_SIZE = 0x40000;
+constexpr uint64_t SLOT = 0x10;
+
+constexpr size_t STAT_SIZE = 144;
+constexpr size_t STATFS_SIZE = 2168;
+constexpr uint16_t S_IFDIR_ = 0040000;
+constexpr uint16_t S_IFREG_ = 0100000;
+constexpr uint64_t O_CREAT_ = 0x0200;  // Darwin's values, not Linux's
+constexpr uint64_t O_TRUNC_ = 0x0400;
+constexpr uint64_t ENOENT_ = 2;
+constexpr uint64_t EBADF_ = 9;
+constexpr uint64_t EEXIST_ = 17;
+constexpr uint64_t EISDIR_ = 21;
+constexpr uint64_t FAILED = ~static_cast<uint64_t>(0);
+
+const char *const DATA_SYMBOLS[] = {
+        "stack_chk_guard",       "kCFAllocatorDefault",    "kCFBooleanFalse",
+        "kCFBooleanTrue",        "kCFErrorDomainOSStatus", "kCFURLFileSecurityKey",
+        "kCFURLIsDirectoryKey",  "kCFURLIsHiddenKey",      "kCFURLTypeIdentifierKey",
+        "kUTTypePlainText",
+};
+
+const int ARG_REGS[] = {UC_X86_REG_RDI, UC_X86_REG_RSI, UC_X86_REG_RDX,
+                        UC_X86_REG_RCX, UC_X86_REG_R8,  UC_X86_REG_R9};
+
+std::string norm(const std::string &s) {
+    const size_t i = s.find_first_not_of('_');
+    return i == std::string::npos ? std::string() : s.substr(i);
+}
+
+bool isDataSymbol(const std::string &normalised) {
+    for (const char *d : DATA_SYMBOLS) {
+        if (normalised == d) return true;
+    }
+    return false;
+}
+
+// CRC-32, as the Python harness does (zlib.crc32), so inodes are stable per path.
+uint64_t inode(const std::string &path) {
+    uint32_t crc = ~0u;
+    for (const unsigned char b : path) {
+        crc ^= b;
+        for (int i = 0; i < 8; i++) crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1u)));
+    }
+    return 0x10000 + ((~crc) & 0xFFFFF);
+}
+
+void put16(uint8_t *b, uint16_t v) { std::memcpy(b, &v, 2); }
+void put32(uint8_t *b, uint32_t v) { std::memcpy(b, &v, 4); }
+void put64(uint8_t *b, uint64_t v) { std::memcpy(b, &v, 8); }
+
+}  // namespace
+
+bool Vm::handlerFor(const std::string &n, Handler &out) {
+    auto set = [&](Kind k, uint64_t v = 0) {
+        out = Handler{k, v};
+        return true;
+    };
+    if (n == "stack_chk_fail") return set(Kind::Abort);
+    if (n == "pthread_rwlock_init" || n == "pthread_rwlock_rdlock" ||
+        n == "pthread_rwlock_wrlock" || n == "pthread_rwlock_unlock" ||
+        n == "pthread_rwlock_destroy")
+        return set(Kind::Ret, 0);
+    if (n == "getuid") return set(Kind::Ret, 501);
+    if (n == "umask") return set(Kind::Ret, 0022);
+    if (n == "arc4random") return set(Kind::Ret, 0x12345678);
+    if (n == "arc4random_buf") return set(Kind::Arc4Buf);
+    if (n == "gethostuuid") return set(Kind::HostUuid);
+    if (n == "gettimeofday") return set(Kind::TimeOfDay);
+    if (n == "error") return set(Kind::Errno);  // ___error, i.e. errno's address
+    if (n == "objc_msgSend") return set(Kind::ObjcMsgSend);
+    if (n == "NSVersionOfRunTimeLibrary") return set(Kind::Ret, 0x100000000ull);
+    if (n == "CFErrorGetCode" || n == "CFErrorGetDomain" || n == "CFRelease" ||
+        n == "CSBackupIsItemExcluded" || n == "notify_post")
+        return set(Kind::Ret, 0);
+    if (n == "CSBackupSetItemExcluded" || n == "CFFileSecuritySetMode" ||
+        n == "CFURLSetResourcePropertyForKey")
+        return set(Kind::Ret, 1);
+    if (n == "malloc") return set(Kind::Malloc);
+    if (n == "free" || n == "fchmod" || n == "fcntl" || n == "lockf") return set(Kind::Ret, 0);
+    if (n == "open") return set(Kind::Open);
+    if (n == "close") return set(Kind::Close);
+    if (n == "read") return set(Kind::Read);
+    if (n == "write") return set(Kind::Write);
+    if (n == "lstat$INODE64" || n == "stat$INODE64") return set(Kind::Lstat);
+    if (n == "fstat$INODE64") return set(Kind::Fstat);
+    if (n == "statfs$INODE64") return set(Kind::Statfs);
+    if (n == "mkdir") return set(Kind::Mkdir);
+    if (n == "unlink") return set(Kind::Unlink);
+    if (n == "chmod") return set(Kind::Chmod);
+    if (n == "ftruncate") return set(Kind::Ftruncate);
+    if (n == "getenv") return set(Kind::Getenv);
+    if (n == "CFURLCreateFromFileSystemRepresentation") return set(Kind::CfurlCreate);
+    if (n == "CFURLCopyResourcePropertyForKey") return set(Kind::CfurlCopyProp);
+    return false;
+}
+
+void Vm::check(uc_err err, const char *what) const {
+    if (err != UC_ERR_OK) {
+        throw Error(std::string("unicorn: ") + what + ": " + uc_strerror(err));
+    }
+}
+
+Vm::Vm(const std::vector<uint8_t> &image) {
+    const MachO macho = MachO::parse(image);
+    check(uc_open(UC_ARCH_X86, UC_MODE_64, &uc_), "open");
+
+    try {
+        const std::pair<uint64_t, uint64_t> regions[] = {
+                {RETURN_ADDRESS, PAGE},       {HEAP_ADDRESS, HEAP_SIZE},
+                {STACK_ADDRESS, STACK_SIZE},  {STUB_ADDRESS, STUB_SIZE},
+                {DATA_ADDRESS, DATA_SIZE},    {SCRATCH_ADDRESS, SCRATCH_SIZE},
+                {OBJECT_ADDRESS, OBJECT_SIZE},
+        };
+        for (const auto &r : regions) check(uc_mem_map(uc_, r.first, r.second, UC_PROT_ALL), "map");
+
+        for (const Segment &seg : macho.segments()) {
+            const uint64_t size = (seg.vmsize + PAGE - 1) / PAGE * PAGE;
+            if (size == 0) continue;
+            check(uc_mem_map(uc_, seg.vmaddr, size, UC_PROT_ALL), "map segment");
+            if (seg.filesize != 0) {
+                if (seg.fileoff + seg.filesize > image.size()) {
+                    throw Error("mach-o: segment outside the file");
+                }
+                check(uc_mem_write(uc_, seg.vmaddr, image.data() + seg.fileoff, seg.filesize),
+                      "load segment");
+            }
+        }
+        const std::vector<uint8_t> rets(STUB_SIZE, 0xC3);
+        check(uc_mem_write(uc_, STUB_ADDRESS, rets.data(), rets.size()), "write stubs");
+
+        std::unordered_map<std::string, uint64_t> stubAddr;
+        std::unordered_map<std::string, uint64_t> dataCell;
+        const std::vector<std::string> symbols = macho.bindSymbols();
+        for (size_t i = 0; i < symbols.size(); i++) {
+            const std::string &sym = symbols[i];
+            const std::string n = norm(sym);
+            if (isDataSymbol(n)) {
+                const uint64_t cell = DATA_ADDRESS + i * SLOT;
+                const uint64_t obj = OBJECT_ADDRESS + i * SLOT;
+                writeU64(cell, obj);
+                dataCell[sym] = cell;
+                objectOf_[n] = obj;
+                keyByObject_[obj] = sym;
+            } else {
+                const uint64_t addr = STUB_ADDRESS + i * SLOT;
+                stubAddr[sym] = addr;
+                Handler h{};
+                if (handlerFor(n, h)) handlers_[addr] = h;
+            }
+        }
+        for (const Bind &b : macho.binds()) {
+            uint64_t target;
+            if (auto it = dataCell.find(b.symbol); it != dataCell.end()) {
+                target = it->second;
+            } else if (auto st = stubAddr.find(b.symbol); st != stubAddr.end()) {
+                target = st->second;
+            } else {
+                throw Error("mach-o: unbound symbol " + b.symbol);
+            }
+            writeU64(b.address, target + static_cast<uint64_t>(b.addend));
+        }
+
+        heapCur_ = HEAP_ADDRESS;
+        scratchCur_ = SCRATCH_ADDRESS;
+        objCur_ = OBJECT_ADDRESS;
+        nextUrl_ = OBJECT_ADDRESS;
+        nextFd_ = 3;
+        const uint8_t defaultUuid[16] = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+                                         0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF};
+        std::memcpy(hostUuid_, defaultUuid, 16);
+        dirs_ = {"/", "/Users", "/Users/Shared", STORE_DIR};
+
+        // Long-lived cells (errno, getenv strings) live below the per-call scratch base.
+        errnoAddr_ = bumpScratch(8);
+        const std::pair<const char *, const char *> env[] = {
+                {"HOME", "/Users/aditest"}, {"USER", "aditest"}, {"TMPDIR", "/tmp/"}};
+        std::vector<std::pair<uint64_t, std::string>> cells;
+        for (const auto &kv : env) {
+            const std::string v = kv.second;
+            const uint64_t a = bumpScratch(v.size() + 1);
+            getenvAddr_[kv.first] = a;
+            cells.emplace_back(a, v);
+        }
+        scratchBase_ = scratchCur_;
+        for (const auto &c : cells) {
+            std::vector<uint8_t> bytes(c.second.begin(), c.second.end());
+            bytes.push_back(0);
+            write(c.first, bytes);
+        }
+
+        check(uc_hook_add(uc_, &stubHook_, UC_HOOK_CODE, reinterpret_cast<void *>(&Vm::onStub),
+                          this, STUB_ADDRESS, STUB_ADDRESS + STUB_SIZE - 1),
+              "hook stubs");
+        check(uc_hook_add(uc_, &unmappedHook_, UC_HOOK_MEM_UNMAPPED,
+                          reinterpret_cast<void *>(&Vm::onUnmapped), this, 1, 0),
+              "hook unmapped");
+
+        for (const Segment &seg : macho.segments()) {
+            if (seg.writable && seg.vmsize != 0) {
+                snapshot_.segments.emplace_back(seg.vmaddr, read(seg.vmaddr, seg.vmsize));
+            }
+        }
+        snapshot_.cells = read(DATA_ADDRESS, PAGE);
+        snapshot_.heapCur = heapCur_;
+        snapshot_.objCur = objCur_;
+        snapshot_.nextUrl = nextUrl_;
+        snapshot_.nextFd = nextFd_;
+        zeros_.assign(STACK_SIZE, 0);
+    } catch (...) {
+        uc_close(uc_);
+        uc_ = nullptr;
+        throw;
+    }
+}
+
+Vm::~Vm() {
+    if (uc_ != nullptr) uc_close(uc_);
+}
+
+void Vm::onStub(uc_engine *uc, uint64_t address, uint32_t, void *self) {
+    Vm *vm = static_cast<Vm *>(self);
+    const auto it = vm->handlers_.find(address);
+    if (it == vm->handlers_.end()) return;  // an import nothing needed answering: just `ret`
+    // Nothing may throw past this frame: it is called from inside Unicorn's C code.
+    try {
+        uint64_t result = 0;
+        if (vm->call(it->second, result)) {
+            uc_reg_write(uc, UC_X86_REG_RAX, &result);
+        }
+    } catch (...) {
+        vm->fault_ = "a stand-in for an imported function failed";
+        uc_emu_stop(uc);
+    }
+}
+
+bool Vm::onUnmapped(uc_engine *uc, uc_mem_type type, uint64_t address, int size, int64_t,
+                    void *self) {
+    Vm *vm = static_cast<Vm *>(self);
+    uint64_t rip = 0;
+    uc_reg_read(uc, UC_X86_REG_RIP, &rip);
+    const char *kind = type == UC_MEM_READ_UNMAPPED    ? "read"
+                       : type == UC_MEM_WRITE_UNMAPPED ? "write"
+                                                       : "fetch";
+    char message[160];
+    std::snprintf(message, sizeof message, "%s-unmapped at %#llx (size %d) rip=%#llx", kind,
+                  static_cast<unsigned long long>(address), size,
+                  static_cast<unsigned long long>(rip));
+    vm->fault_ = message;
+    return false;
+}
+
+uint64_t Vm::arg(int i) const {
+    uint64_t v = 0;
+    uc_reg_read(uc_, ARG_REGS[i], &v);
+    return v;
+}
+
+std::string Vm::cstr(uint64_t addr) const {
+    std::string out;
+    while (out.size() < 4096) {
+        uint8_t b = 0;
+        if (uc_mem_read(uc_, addr + out.size(), &b, 1) != UC_ERR_OK || b == 0) break;
+        out.push_back(static_cast<char>(b));
+    }
+    return out;
+}
+
+uint64_t Vm::fail(uint64_t err) {
+    poke32(errnoAddr_, static_cast<uint32_t>(err));
+    return FAILED;
+}
+
+// Writes made on the library's behalf from inside a hook. Failure is ignored, as in the reference:
+// the library supplied the address, and an unmapped one faults on its own at the next access.
+void Vm::poke32(uint64_t addr, uint32_t v) { uc_mem_write(uc_, addr, &v, 4); }
+
+void Vm::poke64(uint64_t addr, uint64_t v) { uc_mem_write(uc_, addr, &v, 8); }
+
+void Vm::fillStat(uint64_t addr, const std::string &path, bool isDir, int64_t size) {
+    uint8_t b[STAT_SIZE] = {};
+    put32(b + 0, 0x1000003);
+    put16(b + 4, static_cast<uint16_t>((isDir ? S_IFDIR_ : S_IFREG_) | 0755));
+    put16(b + 6, isDir ? 2 : 1);
+    put64(b + 8, inode(path));
+    put32(b + 16, 501);
+    put32(b + 20, 20);
+    put64(b + 96, static_cast<uint64_t>(size));
+    put64(b + 104, static_cast<uint64_t>((size + 511) / 512));
+    put32(b + 112, 4096);
+    uc_mem_write(uc_, addr, b, sizeof b);
+}
+
+uint64_t Vm::bumpScratch(uint64_t size) {
+    const uint64_t addr = scratchCur_;
+    scratchCur_ += (size + 0xF) & ~static_cast<uint64_t>(0xF);
+    if (scratchCur_ > SCRATCH_ADDRESS + SCRATCH_SIZE) throw Error("emulation: scratch exhausted");
+    return addr;
+}
+
+bool Vm::call(const Handler &h, uint64_t &r) {
+    switch (h.kind) {
+        case Kind::Abort:
+            fault_ = "stack check failed";
+            uc_emu_stop(uc_);
+            return false;
+        case Kind::Ret:
+            r = h.value;
+            return true;
+        case Kind::Arc4Buf: {
+            const uint64_t buf = arg(0);
+            const size_t n = static_cast<size_t>(arg(1));
+            std::vector<uint8_t> bytes(n);
+            for (size_t i = 0; i < n; i++) bytes[i] = static_cast<uint8_t>(i * 7 + 3);
+            uc_mem_write(uc_, buf, bytes.data(), bytes.size());
+            r = 0;
+            return true;
+        }
+        case Kind::HostUuid:
+            uc_mem_write(uc_, arg(0), hostUuid_, 16);
+            r = 0;
+            return true;
+        case Kind::TimeOfDay: {
+            const uint64_t tv = arg(0);
+            if (tv != 0) {
+                uint64_t s, us;
+                if (frozenTime_ >= 0) {
+                    s = static_cast<uint64_t>(frozenTime_);
+                    us = 0;
+                } else {
+                    timespec now{};
+                    clock_gettime(CLOCK_REALTIME, &now);
+                    s = static_cast<uint64_t>(now.tv_sec);
+                    us = static_cast<uint64_t>(now.tv_nsec / 1000);
+                }
+                poke64(tv, s);
+                poke64(tv + 8, us);
+            }
+            r = 0;
+            return true;
+        }
+        case Kind::Errno:
+            r = errnoAddr_;
+            return true;
+        case Kind::ObjcMsgSend: {
+            const std::string sel = cstr(arg(1));
+            if (sel == "processInfo") {
+                r = objCur_;
+                objCur_ += 0x100;
+            } else if (sel == "operatingSystem") {
+                r = 0x0D;
+            } else if (sel == "isOperatingSystemAtLeastVersion:") {
+                r = 1;
+            } else {
+                r = 0;
+            }
+            return true;
+        }
+        case Kind::Malloc: {
+            // A bump allocator, like the harness Apple has accepted. Nothing is freed: the VM is
+            // put back to its post-load snapshot between sessions instead.
+            const uint64_t size = (std::max<uint64_t>(arg(0), 0x20) + 0xF) & ~static_cast<uint64_t>(0xF);
+            const uint64_t addr = heapCur_;
+            if (addr + size > HEAP_ADDRESS + HEAP_SIZE) {
+                fault_ = "emulated heap exhausted";
+                uc_emu_stop(uc_);
+                return false;
+            }
+            heapCur_ = addr + size;
+            r = addr;
+            return true;
+        }
+        case Kind::Open: {
+            std::string path = cstr(arg(0));
+            const uint64_t flags = arg(1);
+            if (auto it = files_.find(path); it != files_.end()) {
+                if (flags & O_TRUNC_) it->second.clear();
+            } else if (flags & O_CREAT_) {
+                files_[path] = {};
+            } else if (dirs_.count(path) != 0) {
+                r = fail(EISDIR_);
+                return true;
+            } else {
+                r = fail(ENOENT_);
+                return true;
+            }
+            const uint64_t fd = nextFd_++;
+            fds_[fd] = Fd{std::move(path), 0};
+            r = fd;
+            return true;
+        }
+        case Kind::Close:
+            fds_.erase(arg(0));
+            r = 0;
+            return true;
+        case Kind::Read: {
+            const uint64_t fd = arg(0), buf = arg(1);
+            const size_t n = static_cast<size_t>(arg(2));
+            auto it = fds_.find(fd);
+            if (it == fds_.end()) {
+                r = fail(EBADF_);
+                return true;
+            }
+            const auto f = files_.find(it->second.path);
+            static const std::vector<uint8_t> empty;
+            const std::vector<uint8_t> &data = f == files_.end() ? empty : f->second;
+            const size_t start = std::min(it->second.off, data.size());
+            const size_t len = std::min(n, data.size() - start);
+            if (len != 0) uc_mem_write(uc_, buf, data.data() + start, len);
+            it->second.off += len;
+            r = len;
+            return true;
+        }
+        case Kind::Write: {
+            const uint64_t fd = arg(0), buf = arg(1);
+            const size_t n = static_cast<size_t>(arg(2));
+            auto it = fds_.find(fd);
+            if (it == fds_.end()) {
+                r = fail(EBADF_);
+                return true;
+            }
+            std::vector<uint8_t> payload(n);
+            if (n != 0 && uc_mem_read(uc_, buf, payload.data(), n) != UC_ERR_OK) payload.clear();
+            std::vector<uint8_t> &data = files_[it->second.path];
+            const size_t off = it->second.off;
+            if (off > data.size()) data.resize(off, 0);
+            const size_t end = off + payload.size();
+            if (end > data.size()) data.resize(end, 0);
+            std::copy(payload.begin(), payload.end(), data.begin() + static_cast<long>(off));
+            it->second.off = end;
+            r = n;
+            return true;
+        }
+        case Kind::Lstat: {
+            const std::string path = cstr(arg(0));
+            const uint64_t buf = arg(1);
+            if (auto f = files_.find(path); f != files_.end()) {
+                fillStat(buf, path, false, static_cast<int64_t>(f->second.size()));
+                r = 0;
+            } else if (dirs_.count(path) != 0) {
+                fillStat(buf, path, true, 0);
+                r = 0;
+            } else {
+                r = fail(ENOENT_);
+            }
+            return true;
+        }
+        case Kind::Fstat: {
+            const uint64_t fd = arg(0), buf = arg(1);
+            auto it = fds_.find(fd);
+            if (it == fds_.end()) {
+                r = fail(EBADF_);
+                return true;
+            }
+            const auto f = files_.find(it->second.path);
+            const int64_t size = f == files_.end() ? 0 : static_cast<int64_t>(f->second.size());
+            const std::string path = it->second.path;
+            fillStat(buf, path, false, size);
+            r = 0;
+            return true;
+        }
+        case Kind::Statfs: {
+            std::vector<uint8_t> raw(STATFS_SIZE, 0);
+            put32(raw.data(), 0x1000003);
+            uc_mem_write(uc_, arg(1), raw.data(), raw.size());
+            r = 0;
+            return true;
+        }
+        case Kind::Mkdir: {
+            std::string path = cstr(arg(0));
+            if (files_.count(path) != 0 || dirs_.count(path) != 0) {
+                r = fail(EEXIST_);
+                return true;
+            }
+            dirs_.insert(std::move(path));
+            r = 0;
+            return true;
+        }
+        case Kind::Unlink: {
+            const std::string path = cstr(arg(0));
+            r = files_.erase(path) != 0 ? 0 : fail(ENOENT_);
+            return true;
+        }
+        case Kind::Chmod: {
+            const std::string path = cstr(arg(0));
+            r = (files_.count(path) != 0 || dirs_.count(path) != 0) ? 0 : fail(ENOENT_);
+            return true;
+        }
+        case Kind::Ftruncate: {
+            const uint64_t fd = arg(0);
+            const size_t len = static_cast<size_t>(arg(1));
+            auto it = fds_.find(fd);
+            if (it == fds_.end()) {
+                r = fail(EBADF_);
+                return true;
+            }
+            files_[it->second.path].resize(len, 0);
+            r = 0;
+            return true;
+        }
+        case Kind::Getenv: {
+            const auto it = getenvAddr_.find(cstr(arg(0)));
+            r = it == getenvAddr_.end() ? 0 : it->second;
+            return true;
+        }
+        case Kind::CfurlCreate: {
+            const uint64_t buf = arg(1);
+            const size_t len = static_cast<size_t>(arg(2));
+            std::string path(len, '\0');
+            if (len != 0 && uc_mem_read(uc_, buf, path.data(), len) != UC_ERR_OK) path.clear();
+            nextUrl_ += 0x10;
+            urls_[nextUrl_] = path;
+            r = nextUrl_;
+            return true;
+        }
+        case Kind::CfurlCopyProp: {
+            const uint64_t url = arg(0), key = arg(1), out = arg(2);
+            const auto u = urls_.find(url);
+            const std::string path = u == urls_.end() ? std::string() : u->second;
+            const auto k = keyByObject_.find(key);
+            const std::string name = k == keyByObject_.end() ? std::string() : norm(k->second);
+            auto obj = [&](const char *n) {
+                const auto it = objectOf_.find(n);
+                return it == objectOf_.end() ? 0 : it->second;
+            };
+            if (name == "kCFURLIsDirectoryKey") {
+                poke64(out, dirs_.count(path) != 0 ? obj("kCFBooleanTrue") : obj("kCFBooleanFalse"));
+                r = 1;
+            } else if (name == "kCFURLIsHiddenKey") {
+                poke64(out, obj("kCFBooleanFalse"));
+                r = 1;
+            } else if (name == "kCFURLFileSecurityKey" || name == "kCFURLTypeIdentifierKey") {
+                poke64(out, OBJECT_ADDRESS);
+                r = 1;
+            } else {
+                r = 0;
+            }
+            return true;
+        }
+    }
+    r = 0;
+    return true;
+}
+
+uint64_t Vm::invoke(uint64_t address, const std::vector<uint64_t> &args) {
+    for (size_t i = 0; i < args.size() && i < 6; i++) {
+        check(uc_reg_write(uc_, ARG_REGS[i], &args[i]), "set argument");
+    }
+    uint64_t rsp = STACK_ADDRESS + STACK_SIZE - 0x1000;
+    writeU64(rsp, RETURN_ADDRESS);
+    check(uc_reg_write(uc_, UC_X86_REG_RSP, &rsp), "set rsp");
+    uint64_t zero = 0;
+    check(uc_reg_write(uc_, UC_X86_REG_RBP, &zero), "set rbp");
+    fault_.clear();
+
+    const uc_err err = uc_emu_start(uc_, address, RETURN_ADDRESS, 0, 0);
+    if (!fault_.empty()) {
+        const std::string message = fault_;
+        fault_.clear();
+        throw Error("emulation: " + message);
+    }
+    if (err != UC_ERR_OK) {
+        uint64_t rip = 0;
+        uc_reg_read(uc_, UC_X86_REG_RIP, &rip);
+        char message[160];
+        std::snprintf(message, sizeof message, "emulation failed at rip=%#llx: %s",
+                      static_cast<unsigned long long>(rip), uc_strerror(err));
+        throw Error(message);
+    }
+    uint64_t rax = 0;
+    check(uc_reg_read(uc_, UC_X86_REG_RAX, &rax), "read rax");
+    return rax;
+}
+
+void Vm::resetSession() {
+    for (const auto &seg : snapshot_.segments) write(seg.first, seg.second);
+    write(DATA_ADDRESS, snapshot_.cells);
+    check(uc_mem_unmap(uc_, HEAP_ADDRESS, HEAP_SIZE), "unmap heap");
+    check(uc_mem_map(uc_, HEAP_ADDRESS, HEAP_SIZE, UC_PROT_ALL), "map heap");
+    check(uc_mem_write(uc_, STACK_ADDRESS, zeros_.data(), zeros_.size()), "clear stack");
+    const uint64_t base = scratchBase_;
+    const size_t dirty = static_cast<size_t>(scratchCur_ - scratchBase_);
+    heapCur_ = snapshot_.heapCur;
+    objCur_ = snapshot_.objCur;
+    nextUrl_ = snapshot_.nextUrl;
+    nextFd_ = snapshot_.nextFd;
+    scratchCur_ = scratchBase_;
+    fds_.clear();
+    urls_.clear();
+    fault_.clear();
+    writeU64(errnoAddr_, 0);
+    if (dirty != 0) {
+        check(uc_mem_write(uc_, base, zeros_.data(), std::min(dirty, zeros_.size())),
+              "clear scratch");
+    }
+}
+
+uint64_t Vm::scratch(size_t size) { return bumpScratch(size); }
+
+void Vm::scratchReset() { scratchCur_ = scratchBase_; }
+
+void Vm::write(uint64_t addr, const std::vector<uint8_t> &data) {
+    if (data.empty()) return;
+    check(uc_mem_write(uc_, addr, data.data(), data.size()), "write");
+}
+
+void Vm::writeU32(uint64_t addr, uint32_t v) {
+    check(uc_mem_write(uc_, addr, &v, 4), "write");
+}
+
+void Vm::writeU64(uint64_t addr, uint64_t v) {
+    check(uc_mem_write(uc_, addr, &v, 8), "write");
+}
+
+std::vector<uint8_t> Vm::read(uint64_t addr, size_t len) const {
+    std::vector<uint8_t> out(len);
+    if (len != 0) check(uc_mem_read(uc_, addr, out.data(), len), "read");
+    return out;
+}
+
+uint32_t Vm::readU32(uint64_t addr) const {
+    uint32_t v = 0;
+    check(uc_mem_read(uc_, addr, &v, 4), "read");
+    return v;
+}
+
+uint64_t Vm::readU64(uint64_t addr) const {
+    uint64_t v = 0;
+    check(uc_mem_read(uc_, addr, &v, 8), "read");
+    return v;
+}
+
+void Vm::setHostUuid(const uint8_t uuid[16]) { std::memcpy(hostUuid_, uuid, 16); }
+
+}  // namespace macadi
diff --git a/app/src/main/cpp/macadi/vm.h b/app/src/main/cpp/macadi/vm.h
new file mode 100644
index 0000000..3d685fe
--- /dev/null
+++ b/app/src/main/cpp/macadi/vm.h
@@ -0,0 +1,136 @@
+// Apple's macOS CoreADI, x86_64, run under Unicorn - plus the few pieces of macOS userland it
+// asks for.
+//
+// The dylib's preferred base is 0, so every segment is mapped at its literal vmaddr and nothing
+// is rebased. Each imported function gets a stub address holding a single `ret`; a code hook on
+// the stub page runs the handler in C++, sets rax, and the `ret` returns to the caller. Imported
+// data symbols point at per-symbol cells.
+//
+// Ported from sacca97/os-findmy-e (MIT), native/adi-core/src/vm.rs, which in turn mirrors the
+// Python harness its results were measured with. Behaviour is kept identical on purpose, down to
+// the deterministic arc4random: that harness is what Apple has been seen to accept, and a
+// "tidier" stand-in is an untested one.
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <unicorn/unicorn.h>
+
+namespace macadi {
+
+// Where the library keeps its provisioning state. A virtual directory: the files live in memory
+// here, and Java persists them between sessions.
+extern const char *const STORE_DIR;
+
+class Vm {
+public:
+    explicit Vm(const std::vector<uint8_t> &image);
+    ~Vm();
+    Vm(const Vm &) = delete;
+    Vm &operator=(const Vm &) = delete;
+
+    // Run address(args...) until it returns to our sentinel; the result is rax.
+    uint64_t invoke(uint64_t address, const std::vector<uint64_t> &args);
+
+    // Back to the state right after loading, as if a fresh process had started. The store, the
+    // host UUID and the clock are kept; library memory, descriptors and allocator counters are
+    // not. Translated code stays cached, which is what makes this cheap. Between sessions only -
+    // a provisioning session id lives in library memory.
+    void resetSession();
+
+    // Per-call scratch for request buffers and out-cells, reset between top-level calls.
+    uint64_t scratch(size_t size);
+    void scratchReset();
+
+    void write(uint64_t addr, const std::vector<uint8_t> &data);
+    void writeU32(uint64_t addr, uint32_t v);
+    void writeU64(uint64_t addr, uint64_t v);
+    std::vector<uint8_t> read(uint64_t addr, size_t len) const;
+    uint32_t readU32(uint64_t addr) const;
+    uint64_t readU64(uint64_t addr) const;
+
+    std::map<std::string, std::vector<uint8_t>> &files() { return files_; }
+
+    void setHostUuid(const uint8_t uuid[16]);
+
+    // Pin gettimeofday to `secs` for tests; negative is the real clock.
+    //
+    // Never in the app. A frozen clock makes the OTP a constant, and Apple then accepts the
+    // machine for about a minute and refuses it after (os-findmy-e EVIDENCE.md sections 8-9).
+    void setFrozenTime(int64_t secs) { frozenTime_ = secs; }
+
+private:
+    enum class Kind {
+        Abort, Ret, Arc4Buf, HostUuid, TimeOfDay, Errno, ObjcMsgSend, Malloc, Open, Close, Read,
+        Write, Lstat, Fstat, Statfs, Mkdir, Unlink, Chmod, Ftruncate, Getenv, CfurlCreate,
+        CfurlCopyProp,
+    };
+    struct Handler {
+        Kind kind;
+        uint64_t value;
+    };
+    struct Fd {
+        std::string path;
+        size_t off;
+    };
+    struct Snapshot {
+        std::vector<std::pair<uint64_t, std::vector<uint8_t>>> segments;
+        std::vector<uint8_t> cells;
+        uint64_t heapCur;
+        uint64_t objCur;
+        uint64_t nextUrl;
+        uint64_t nextFd;
+    };
+
+    static bool handlerFor(const std::string &name, Handler &out);
+    static void onStub(uc_engine *uc, uint64_t address, uint32_t size, void *self);
+    static bool onUnmapped(uc_engine *uc, uc_mem_type type, uint64_t address, int size,
+                           int64_t value, void *self);
+
+    // Runs the stand-in for one imported function. Returns false when it stopped the emulation
+    // instead of returning a value.
+    bool call(const Handler &h, uint64_t &result);
+
+    uint64_t arg(int i) const;
+    std::string cstr(uint64_t addr) const;
+    uint64_t fail(uint64_t err);
+    void poke32(uint64_t addr, uint32_t v);
+    void poke64(uint64_t addr, uint64_t v);
+    void fillStat(uint64_t addr, const std::string &path, bool isDir, int64_t size);
+    uint64_t bumpScratch(uint64_t size);
+    void check(uc_err err, const char *what) const;
+
+    uc_engine *uc_ = nullptr;
+    uc_hook stubHook_ = 0;
+    uc_hook unmappedHook_ = 0;
+
+    std::unordered_map<uint64_t, Handler> handlers_;
+    std::unordered_map<std::string, uint64_t> objectOf_;
+    std::unordered_map<uint64_t, std::string> keyByObject_;
+    uint64_t heapCur_ = 0;
+    uint64_t scratchCur_ = 0;
+    uint64_t scratchBase_ = 0;
+    uint64_t objCur_ = 0;
+    uint64_t nextUrl_ = 0;
+    uint64_t errnoAddr_ = 0;
+    std::map<std::string, uint64_t> getenvAddr_;
+    std::map<std::string, std::vector<uint8_t>> files_;
+    std::set<std::string> dirs_;
+    std::map<uint64_t, Fd> fds_;
+    uint64_t nextFd_ = 3;
+    std::map<uint64_t, std::string> urls_;
+    uint8_t hostUuid_[16];
+    int64_t frozenTime_ = -1;
+    std::string fault_;
+
+    Snapshot snapshot_;
+    std::vector<uint8_t> zeros_;
+};
+
+}  // namespace macadi
