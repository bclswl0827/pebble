@@ -0,0 +1,41 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * {@link SessionProvenance}'s store as a map: what is in {@code LocalAnisette.PREFERENCES}, by key.
+ *
+ * <p>Tests write the keys by name, the way an install from before the emulated Mac has them, rather
+ * than through {@link SessionProvenance}, so "an older install" means the file such an install
+ * actually has.
+ */
+final class MemoryProvenance implements SessionProvenance.Store {
+    final Map<String, Object> values = new HashMap<>();
+
+    @Override
+    public boolean getBoolean(final String key) {
+        final Object value = this.values.get(key);
+        return value instanceof Boolean && (Boolean) value;
+    }
+
+    @Override
+    public String getString(final String key) {
+        final Object value = this.values.get(key);
+        return value instanceof String ? (String) value : null;
+    }
+
+    @Override
+    public void put(final boolean establishedLocally, final String machine) {
+        this.values.put(SessionProvenance.KEY_ESTABLISHED_LOCALLY, establishedLocally);
+        if (machine == null) {
+            this.values.remove(SessionProvenance.KEY_MACHINE);
+        } else {
+            this.values.put(SessionProvenance.KEY_MACHINE, machine);
+        }
+    }
+
+    SessionProvenance provenance() {
+        return new SessionProvenance(this);
+    }
+}
diff --git a/app/src/test/java/dev/wander/android/opentagviewer/anisette/RestoringASessionOnTheMachineThatSignedItInTest.java b/app/src/test/java/dev/wander/android/opentagviewer/anisette/RestoringASessionOnTheMachineThatSignedItInTest.java
new file mode 100644
index 0000000..5cede9a
--- /dev/null
+++ b/app/src/test/java/dev/wander/android/opentagviewer/anisette/RestoringASessionOnTheMachineThatSignedItInTest.java
@@ -0,0 +1,86 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/**
+ * Which Anisette each caller gets: a fresh sign-in the emulated Mac, a restore the machine that
+ * signed the session in.
+ *
+ * <p>The case this exists for is the upgrade. A session {@link LocalAnisette} established before
+ * the emulated Mac existed still fetches reports, its token is bound to the Android machine (#248),
+ * and its install has nothing but {@code sessionEstablishedLocally} in
+ * {@code LocalAnisette.PREFERENCES}. It must stay on {@link LocalAnisette}, and nothing may be
+ * provisioned to restore it.
+ */
+public class RestoringASessionOnTheMachineThatSignedItInTest {
+
+    private static AnisetteForSession.Choice restoring(final MemoryProvenance file) {
+        return AnisetteForSession.choose(true, file.provenance());
+    }
+
+    @Test
+    public void aSessionLocalAnisetteSignedInBeforeTheUpgradeKeepsLocalAnisette() {
+        // Exactly what an older install has on disk: LocalAnisette's key, and nothing beside it.
+        final MemoryProvenance olderInstall = new MemoryProvenance();
+        olderInstall.values.put("sessionEstablishedLocally", true);
+
+        assertEquals(AnisetteForSession.Choice.ANDROID, restoring(olderInstall));
+        assertTrue("the provenance LocalAnisette wrote must still read as local",
+                olderInstall.provenance().establishedLocally());
+    }
+
+    @Test
+    public void aSessionSignedInThroughAServerBeforeTheUpgradeKeepsLocalAnisettesHandling() {
+        final MemoryProvenance olderInstall = new MemoryProvenance();
+        olderInstall.values.put("sessionEstablishedLocally", false);
+
+        assertEquals(AnisetteForSession.Choice.ANDROID, restoring(olderInstall));
+    }
+
+    @Test
+    public void anInstallThatNeverRecordedAnythingKeepsLocalAnisette() {
+        assertEquals(AnisetteForSession.Choice.ANDROID, restoring(new MemoryProvenance()));
+    }
+
+    @Test
+    public void aSessionTheEmulatedMacSignedInIsRestoredOntoIt() {
+        final MemoryProvenance file = new MemoryProvenance();
+        file.provenance().recordEmulatedMacSession(true);
+
+        assertEquals(AnisetteForSession.Choice.EMULATED_MAC_FOR_RESTORE, restoring(file));
+    }
+
+    @Test
+    public void aFreshSignInGetsTheEmulatedMacWhateverCameBefore() {
+        final MemoryProvenance olderInstall = new MemoryProvenance();
+        olderInstall.values.put("sessionEstablishedLocally", true);
+
+        assertEquals(AnisetteForSession.Choice.EMULATED_MAC_FOR_SIGN_IN,
+                AnisetteForSession.choose(false, olderInstall.provenance()));
+    }
+
+    @Test
+    public void theMacRecordsInTheFileLocalAnisetteAlwaysUsed() {
+        final MemoryProvenance file = new MemoryProvenance();
+        file.provenance().recordEmulatedMacSession(true);
+
+        assertEquals(true, file.values.get("sessionEstablishedLocally"));
+        assertEquals("emulatedMac", file.values.get("sessionMachine"));
+    }
+
+    @Test
+    public void signingInAgainThroughLocalAnisetteClearsTheMac() {
+        final MemoryProvenance file = new MemoryProvenance();
+        file.provenance().recordEmulatedMacSession(true);
+        file.provenance().recordAndroidSession(true);
+
+        assertNull(file.values.get("sessionMachine"));
+        assertFalse(file.provenance().signedInAsEmulatedMac());
+        assertEquals(AnisetteForSession.Choice.ANDROID, restoring(file));
+    }
+}
diff --git a/app/src/test/java/dev/wander/android/opentagviewer/anisette/TestPlists.java b/app/src/test/java/dev/wander/android/opentagviewer/anisette/TestPlists.java
new file mode 100644
index 0000000..cd4d7cd
--- /dev/null
+++ b/app/src/test/java/dev/wander/android/opentagviewer/anisette/TestPlists.java
@@ -0,0 +1,113 @@
+package dev.wander.android.opentagviewer.anisette;
+
+import org.w3c.dom.Element;
+import org.w3c.dom.Node;
+import org.w3c.dom.NodeList;
+
+import java.io.ByteArrayInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.xml.parsers.DocumentBuilderFactory;
+import java.util.Base64;
+
+/**
+ * {@link SimplePlist#parse}'s shapes, from the JDK's DOM parser.
+ *
+ * <p>{@code SimplePlist} uses {@code android.util.Xml}, which is a stub on the JVM. This reads the
+ * same documents into the same maps and strings, so {@link SimplePlist#string} works on the result
+ * unchanged and what is under test is {@link MacProvisioning}, not a parser.
+ */
+final class TestPlists {
+
+    private TestPlists() {
+    }
+
+    static Object parse(final String xml) throws Exception {
+        final DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+        // Apple's DOCTYPE points at a URL; nothing here should fetch it.
+        factory.setFeature("http://apache.org/xml/features/nonvalidating/load-external-dtd", false);
+        final Element plist = factory.newDocumentBuilder()
+                .parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8)))
+                .getDocumentElement();
+        for (final Element child : children(plist)) {
+            return value(child);
+        }
+        throw new IllegalArgumentException("no value in the plist");
+    }
+
+    private static Object value(final Element element) {
+        switch (element.getTagName()) {
+            case "dict": {
+                final Map<String, Object> out = new HashMap<>();
+                final List<Element> items = children(element);
+                for (int i = 0; i + 1 < items.size(); i += 2) {
+                    out.put(items.get(i).getTextContent(), value(items.get(i + 1)));
+                }
+                return out;
+            }
+            case "array": {
+                final List<Object> out = new ArrayList<>();
+                for (final Element child : children(element)) {
+                    out.add(value(child));
+                }
+                return out;
+            }
+            case "true":
+            case "false":
+                return "true".equals(element.getTagName());
+            default:
+                return element.getTextContent();
+        }
+    }
+
+    private static List<Element> children(final Element parent) {
+        final List<Element> out = new ArrayList<>();
+        final NodeList nodes = parent.getChildNodes();
+        for (int i = 0; i < nodes.getLength(); i++) {
+            if (nodes.item(i).getNodeType() == Node.ELEMENT_NODE) {
+                out.add((Element) nodes.item(i));
+            }
+        }
+        return out;
+    }
+
+    /** A plist dictionary of strings, with one nested level, as Apple's answers are written. */
+    static String dict(final Map<String, ?> entries) {
+        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+                + "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+                + "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+                + "<plist version=\"1.0\">" + body(entries) + "</plist>";
+    }
+
+    private static String body(final Map<String, ?> entries) {
+        final StringBuilder out = new StringBuilder("<dict>");
+        for (final Map.Entry<String, ?> entry : entries.entrySet()) {
+            out.append("<key>").append(entry.getKey()).append("</key>");
+            if (entry.getValue() instanceof Map) {
+                @SuppressWarnings("unchecked")
+                final Map<String, ?> nested = (Map<String, ?>) entry.getValue();
+                out.append(body(nested));
+            } else {
+                out.append("<string>").append(entry.getValue()).append("</string>");
+            }
+        }
+        return out.append("</dict>").toString();
+    }
+
+    /** {@code java.util.Base64}, for the tests; the app's is {@code android.util.Base64}. */
+    static final Base64Codec BASE64 = new Base64Codec() {
+        @Override
+        public String encode(final byte[] data) {
+            return Base64.getEncoder().encodeToString(data);
+        }
+
+        @Override
+        public byte[] decode(final String text) {
+            return Base64.getMimeDecoder().decode(text);
+        }
+    };
+}
